ckground:#eee5f5}.knob-comparison-scroll{overflow-x:auto;padding:4px 8px 24px}.knob-comparison-row{display:grid;grid-template-columns:repeat(5,minmax(200px,1fr));gap:18px;min-width:1072px}.knob-comparison-item{width:100%;min-width:0;margin:0;text-align:center}.knob-comparison-item h2{margin:0 0 24px;font-size:18px;line-height:1.4;font-weight:500}.knob-comparison-item .hw-dial{width:100%}.knob-comparison-item .hw-outer-ring{cursor:default}.knob-comparison-item .hw-ring-indicator{--rotation: 0deg}.knob-comparison-item figcaption{display:flex;flex-direction:column;align-items:center;gap:10px;margin-top:28px;color:#77717f;font-size:12px;line-height:1.4}.knob-comparison-color{display:inline-flex;align-items:center;gap:7px;color:#4f4659}.knob-comparison-color i{width:9px;height:9px;border-radius:50%;background:var(--knob-status-color);box-shadow:0 0 0 1px #352e4012}.knob-comparison-color code{color:#77717f;font:11px var(--font-mono)}.knob-state-comparison[data-playing=false] .hw-dial *,.knob-state-comparison[data-playing=false] .hw-dial *:before,.knob-state-comparison[data-playing=false] .hw-dial *:after{animation:none!important;transition:none!important}@media(max-width:680px){.hw-state-compare{padding:24px 16px}.knob-comparison-heading{flex-direction:column;align-items:flex-start;margin-bottom:32px}}

