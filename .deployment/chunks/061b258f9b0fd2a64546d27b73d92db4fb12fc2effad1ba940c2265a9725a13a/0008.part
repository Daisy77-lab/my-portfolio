ition:absolute;top:68%;left:0;width:100%;display:flex;align-items:center;justify-content:center;gap:2cqi;color:var(--text-primary)}.knob-home-progress strong{font-size:12cqi;font-weight:400;line-height:1;font-variant-numeric:tabular-nums}.knob-home-progress small{font-size:5cqi;padding-left:1cqi}.knob-home-progress>svg{width:5cqi;height:5cqi}.knob-press-hint{position:absolute;bottom:9%;left:0;width:100%;color:var(--wheel-secondary);display:flex;align-items:center;justify-content:center;gap:2cqi;pointer-events:none}.knob-press-hint svg{width:7cqi;height:7cqi;flex:none;stroke-width:1.6}.knob-press-hint .knob-hint-arrow{width:4.5cqi;height:4.5cqi;opacity:.6}.knob-home-screen .knob-press-hint{bottom:7%}.knob-task-symbol{position:absolute;top:17%;width:100%;display:flex;justify-content:center;color:var(--wheel-secondary)}.knob-task-symbol svg{width:9cqi;height:9cqi;stroke-width:1.5}.knob-progress-value{position:absolute;top:34%;width:100%;display:flex;justify-content:center;align-items:baseline;gap:1.5cqi;color:var(--text-primary)}.knob-progress-value strong{font-weight:400;font-size:22cqi;line-height:1;font-variant-numeric:tabular-nums}.knob-progress-value>span{font-size:7cqi}.knob-stage-steps{position:absolute;top:61%;left:24%;width:52%;display:flex;justify-content:space-between;align-items:center}.knob-stage-steps:before{content:"";position:absolute;top:50%;left:10%;right:10%;height:1px;background:var(--wheel-muted);opacity:.3}.knob-stage-steps i{position:relative;width:10cqi;height:10cqi;display:flex;align-items:center;justify-content:center;border-radius:50%;border:1px solid var(--border-default);background:var(--wheel-bg);color:var(--wheel-muted);font-size:5cqi;font-style:normal}.knob-stage-steps .is-current{border-color:var(--knob-status-color);color:var(--knob-status-color)}.knob-stage-steps .is-done{color:var(--knob-status-color)}.knob-stage-steps svg{width:5cqi;height:5cqi}.knob-progress-screen .knob-state-symbol{top:77%;left:67%;width:8%}.knob-progress-screen 