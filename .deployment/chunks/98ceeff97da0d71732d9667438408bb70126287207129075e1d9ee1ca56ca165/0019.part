'},
 {title:'腾讯投资',desc:'投资关系、主体与公开依据待核验。当前不展示投资方 Logo。',number:'Investment',caption:'投资背景 · 关系与凭据待核验',img:'data:image/jpeg;base64,'},
 {title:'80 多家合作伙伴',desc:'合作伙伴范围、授权及统计口径待确认。当前不展示虚构客户墙。',number:'80+',caption:'合作伙伴 · 名单与授权待补',img:'data:image/jpeg;base64,'},
 {title:'10000 多用户',desc:'用户数量、统计时点与口径待核验。当前不添加虚构用户评价。',number:'10,000+',caption:'用户数量 · 统计口径待补',img:'data:image/jpeg;base64,'}];
let wi=0,whyAuto=false,whyPause=false,whyTime=0,whyLast=0;
$('#whyOptions').innerHTML=whyData.map((x,i)=>`<button class="why-item" id="why-tab-${i}" role="tab" aria-controls="whyPanel" aria-selected="${i===0}" tabindex="${i===0?0:-1}" data-why="${i}"><i class="progress"></i><h3><span class="index">0${i+1}</span>${x.title}</h3><span class="why-detail">${x.desc}</span></button>`).join('');
function setWhy(i){wi=i;whyTime=0;const x=whyData[i];$$('[data-why]').forEach(b=>{b.setAttribute('aria-selected',String(Number(b.dataset.why)===i));b.tabIndex=Number(b.dataset.why)===i?0:-1;b.querySelector('.progress').style.width='0';});$('#whyImage').src=x.img;$('#whyImage').alt=x.caption+'；当前图为模型或概念素材，不是实证配图';$('#whyNumber').textContent=x.number;$('#whyNumber').style.fontSize=i===1?'40px':'';$('#whyImageText').textContent=x.caption;$('#whyPanel').setAttribute('aria-labelledby','why-tab-'+i);}
function stopWhy(){whyAuto=false;$('#whyAuto').setAttribute('aria-pressed','false');$('#whyAuto').innerHTML='演示轮播 <span>▶</span>';}
$$('[data-why]').forEach(b=>{b.onclick=()=>{stopWhy();setWhy(Number(b.dataset.why));};b.onkeydown=e=>{if(['ArrowDown','ArrowRight','ArrowUp','ArrowLeft','Home','End'].includes(e.key)){e.preventDefault();stopWhy();let i=e.key==='Home'?0:e.key==='End'?3:(wi+(['ArrowRight','ArrowDown'].includes(e.key)?1:-1)+4)%4;setWhy(i);$('#why-tab-'+i).focus();}};});
$('#whyAuto').onclick=()=>{if(whyAuto){stopWhy();return;}whyAuto=true;whyTime=0;whyLast=0;$('#whyAuto').setAttribute('aria-pressed','true');$('#whyAuto').innerHTML='暂停演示 <span>Ⅱ</span>';};
$('.why-layout').addEventListener('pointerenter',()=>whyPause=true);$('.why-layout').addEventListener('pointerleave',()=>whyPause=false);$('.why-layout').addEventListener('focusin',stopWhy);
function whyTick(t){const dt=whyLast?Math.min(t-whyLast,100):0;whyLast=t;const r=$('#why').getBoundingClientRect(),vis=r.top<innerHeight*.75&&r.bottom>innerHeight*.25;if(whyAuto&&!whyPause&&!reduced.matches&&!document.hidden&&!window.__pxRouteOpen&&vis&&!$('dialog[open]')){whyTime+=dt;$('#why-tab-'+wi+' .progress').style.width=(whyTime/6000*100)+'%';if(whyTime>=6000)setWhy((wi+1)%4);}requestAnimationFrame(whyTick);}requestAnimationFrame(whyTick);
// Forms perform local validation only; never simulate a sent message.
$('#subscribeForm').addEventListener('submit',e=>{e.preventDefault();const input=$('#subscribeEmail'),ok=input.checkValidity();input.setAttribute('aria-invalid',String(!ok));$('#subscribeMessage').textContent=ok?'格式检查通过。这是草稿演示，邮箱没有发送或保存。':'请输入有效的邮箱地址，例如 name@example.com。';if(!ok)input.focus();});
document.addEventListener('submit',e=>{if(e.target.id!=='contactDraft')return;e.preventDefault();const invalid=[...e.target.querySelectorAll('[required]')].find(x=>!x.checkValidity());e.target.querySelectorAll('[required]').forEach(x=>x.setAttribute('aria-invalid',String(!x.checkValidity())));$('#contactStatus').textContent=invalid?'请填写完整称呼、有效邮箱和说明。':'格式检查通过。未连接服务端，没有提交或保存你的信息。';invalid?.focus();});
$('#reviewOpen').onclick=()=>{closeMenu();pauseMaterials();$('#reviewDialog').showModal();$('#reviewClose').focus();};$('#reviewClose').onclick=()=>$('#reviewDialog').close();$('#reviewDialog').addEventListener('close',updateMaterials);
$('#openReferences').onclick=()=>{$('#reviewDialog').close();openDialog('模块与参考对应',references.map(([name,description,url])=>`<div style="padding:15px 0;border-top:1px solid var(--line)"><h3 style="font-size:18px">${name}</h3><p class="fine" style="margin-top:7px">${description}</p>${url?`<a class="text-link" href="${url}" target="_blank" rel="noopener noreferrer">打开对应参考 ↗</a>`:''}</div>`).join(''));};
$('#openMediaImports').onclick=()=>{$('#reviewDialog').close();openDialog('本地素材接入',`<p>接入当前组合：<strong>${mats.find(x=>x[0]===ms.material)[2]} / ${projects.find(x=>x[0]===ms.project)[1]}</strong>。只在浏览器会话中读取，不上传；刷新后需重新导入。</p><div class="media-imports"><label>CNC 加工影片<input type="file" accept="video/mp4,video/webm" data-import="process"></label><label>对应作品影片<input type="file" accept="video/mp4,video/webm" data-import="result"></label></div><div class="warning">请导入同一材质、同一作品的镜头。加工片由“播放加工演示”触发；作品影片在滚动进入后自动静音播放。此接入口不负责生成新影片。</div><p id="importStatus" role="status" class="fine" style="margin-top:20px"></p>`);const rec=currentRecipe();$$('[data-import]').forEach(x=>x.onchange=()=>{const f=x.files[0];if(!f)return;let a=mediaByRecipe.get(rec)||{};if(a[x.dataset.import])URL.revokeObjectURL(a[x.dataset.import]);a[x.dataset.import]=URL.createObjectURL(f);mediaByRecipe.set(rec,a);$('#importStatus').textContent='已在本次会话接入：'+f.name;ms.filmPaused=reduced.matches;updateMaterials();});};
window.addEventListener('scroll',()=>{scheduleMaterial();},{passive:true});window.addEventListener('resize',scheduleMaterial);document.addEventListener('visibilitychange',()=>{if(document.hidden)pauseMaterials();scheduleMaterial();});reduced.addEventListener('change',()=>{stopWhy();ms.filmPaused=reduced.matches;scheduleMaterial();});
window.PalmXSite={navigate,jump,openMenu,matGo,setWhy,state:()=>({route:currentRoute,menu,category,materials:{...ms},why:wi,whyAuto,reduced:reduced.matches}),review:()=>$('#reviewOpen').click()};
updateMaterials();
})();
</script>
</body></html>
