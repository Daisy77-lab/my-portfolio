", "data:image/jpeg;base64,", "data:image/jpeg;base64,"],thumbs={"axis": "data:image/jpeg;base64,"};
const s={p:0,phase:0,key:null,open:false,auto:false,last:0,duration:18,ready:false,requested:0,displayed:0,cardManual:false};let hideTimer,autoLast=0,frameBox={x:0,y:0,w:0,h:0},lastKey=null,oldFocus=null;
const clamp=(v,a=0,b=1)=>Math.max(a,Math.min(b,v));const smooth=t=>{t=clamp(t);return t*t*(3-2*t)};
const chapters=[['01 / WHOLE MACHINE','正面整机',''],['02 / ENTER THE WORKSPACE','进入加工空间','局部遮挡退去，部件保持原位。'],['03 / AXIS ASSEMBLY','轴体结构','将鼠标靠近结构，查看局部分析。'],['04 / RIGHT OBSERVATION','右侧刀库观察位','先验证向右运镜；刀库对象尚待绑定。'],['05 / LOOKING UP','顶部激光观察位','低位仰视；激光对象身份尚待核对。']];
const cards={axis:{title:'轴体结构',text:'局部弱化遮挡外层，观察轴体与作业区的空间关系。部件保持原位；具体传动与性能说明待核实。',tag:'原网格局部 · 展示性透视',thumb:true},right:{title:'刀库 · 待绑定',text:'此处先验证向右观察和靠近查看的交互。尚未确认刀库对应网格，不把画面中的单个主轴刀头当作刀库。',tag:'观察区占位 · 不演示换刀',thumb:false},upper:{title:'顶部激光 · 待核对',text:'从低位向上观察顶部安装区域。具体激光对象确认后接入结构图与说明；本稿不添加光束或加工动作。',tag:'观察区占位 · 用途与参数待核验',thumb:false}};
function readP(){return clamp(-track.getBoundingClientRect().top/Math.max(1,track.offsetHeight-innerHeight))}
function go(p){window.scrollTo({top:(track.getBoundingClientRect().top+scrollY)+clamp(p)*(track.offsetHeight-innerHeight),behavior:'instant'});s.p=readP();update()}
function stopAuto(){s.auto=false;$('auto').textContent='自动演示';$('auto').setAttribute('aria-pressed','false')}
function closeCard(){clearTimeout(hideTimer);s.open=false;$('callout').classList.remove('visible');$('callout').setAttribute('aria-hidden','true');$('callout').inert=true;$('connector').classList.remove('visible');$('anchor').classList.remove('active');$('anchor').setAttribute('aria-expanded','false')}
function showCard(){if(!s.key)return;clearTimeout(hideTimer);const c=cards[s.key];$('cardTitle').textContent=c.title;$('cardText').textContent=c.text;$('cardTag').textContent=c.tag;$('thumb').hidden=!c.thumb;$('thumbPlaceholder').hidden=c.thumb;$('thumbPlaceholder').innerHTML=s.key==='right'?'刀库对象<br>待绑定':'激光对象<br>待核对';if(c.thumb)$('thumb').src=thumbs.axis;s.open=true;$('callout').inert=false;$('callout').setAttribute('aria-hidden','false');$('callout').classList.add('visible');$('connector').classList.add('visible');$('anchor').classList.add('active');$('anchor').setAttribute('aria-expanded','true');placeCard()}
function delayClose(){clearTimeout(hideTimer);hideTimer=setTimeout(closeCard,250)}
function layout(){let w=innerWidth,h=innerHeight;const mw=w<768?w*1.8:Math.min(w,h*16/9),mh=mw*9/16;frameBox={x:(w-mw)/2,y:w<768?h*.48-mh*.5:(h-mh)/2,w:mw,h:mh};Object.assign($('sceneFrame').style,{left:frameBox.x+'px',top:frameBox.y+'px',width:mw+'px',height:mh+'px'});update()}
function projected(){const i=Math.round(s.displayed*(data.length-1)),point=data[clamp(i,0,data.length-1)].points[s.key||'axis'];return{x:frameBox.x+point[0]*frameBox.w,y:frameBox.y+point[1]*frameBox.h}}
function placeCard(){if(!s.key)return;const p=projected(),w=innerWidth,h=innerHeight;const ax=clamp(p.x,54,w-54),ay=clamp(p.y,180,h-165);$('anchor').style.left=ax+'px';$('anchor').style.top=ay+'px';if(!s.open)return;const card=$('callout'),cw=card.offsetWidth||410,ch=card.offsetHeight||210;let x,y;if(w<768){x=20;y=clamp(ay+66,190,h-ch-112)}else{const rightFits=ax+100+cw<w-30;x=rightFits?ax+100:ax-cw-100;y=clamp(ay-ch*.33,150,h-ch-108);x=clamp(x,30,w-cw-30)}Object.assign(card.style,{left:x+'px',top:y+'px'});const ex=x>ax?x:x+cw,ey=clamp(ay,y+24,y+ch-24);$('leadLine').setAttribute('d',`M${ax},${ay} L${ax+(ex-ax)*.42},${ay} L${ex},${ey}`);$('leadDot').setAttribute('cx',ax);$('leadDot').setAttribute('cy',ay)}
function update(){if(window.__pxRouteOpen)return;s.p=readP();const p=s.p;s.phase=p<.18?0:p<.38?1:p<.58?2:p<.8?3:4;const c=chapters[s.phase];$('serial').textContent=c[0];$('sceneTitle').textContent=c[1];$('sceneSubtitle').textContent=c[2];const fade=smooth((p-.16)/.13);$('heroTitle').style.opacity=1-fade;$('heroTitle').style.transform=`translateY(${-12*fade}px)`;$('insideTitle').style.opacity=fade;$('quality').textContent=s.phase===0?'v57 原网格 · 交互评审草稿':s.phase===1?'遮挡面展示性淡化 · 无开门动作':s.phase===2?'轴体 / 邻接结构 · 说明待核实':s.phase===3?'右侧观察位 · 刀库对象未绑定':'顶部观察位 · 激光对象待核对';const nk=p>=.405&&p<.58?'axis':p>=.70&&p<.80?'right':p>=.925?'upper':null;if(nk!==s.key){closeCard();s.key=nk;$('anchor').hidden=!nk;$('anchorLabel').textContent=nk==='axis'?'靠近查看结构':nk==='right'?'右侧区域 · 待绑定':'顶部区域 · 待核对';$('anchor').setAttribute('aria-label',nk?cards[nk].title+'，显示说明':'结构说明')}root.querySelectorAll('[data-p]').forEach((b,i)=>i===s.phase?b.setAttribute('aria-current','step'):b.removeAttribute('aria-current'));$('overall').style.width=(p*100)+'%';$('hint').textContent=p<.38?'↓ 向下滚动，进入加工空间':s.key?(innerWidth<768?'点按标记查看 · 下滚继续':'靠近标记查看 · 下滚继续'):'↓ 滚动推进镜头';if(rm.matches){s.displayed=p;stage.classList.add('static');$('staticFrame').src=stills[s.phase<=1?0:s.phase===2?1:s.phase===3?2:3];$('load').hidden=true}else{stage.classList.remove('static');seek(p)}placeCard()}
function seek(p){s.requested=p;if(!s.ready||film.seeking)return;const target=p*Math.max(0,film.duration-.04);if(Math.abs(target-film.currentTime)>.022){try{film.currentTime=target}catch{}}else{s.displayed=p;placeCard()}}
film.addEventListener('loadeddata',()=>{s.ready=true;$('load').hidden=true;seek(s.p)});film.addEventListener('seeked',()=>{s.displayed=clamp(film.currentTime/Math.max(.001,film.duration-.04));placeCard();seek(s.requested)});film.addEventListener('error',()=>{$('load').textContent='此浏览器无法读取视频，当前显示结构静帧。';stage.classList.add('static');$('staticFrame').src=stills[0]});film.pause();
$('anchor').addEventListener('pointerenter',showCard);$('anchor').addEventListener('pointerleave',delayClose);$('anchor').addEventListener('focus',showCard);$('anchor').addEventListener('blur',e=>{if(!$('callout').contains(e.relatedTarget))delayClose()});$('anchor').addEventListener('click',showCard);$('callout').addEventListener('pointerenter',()=>clearTimeout(hideTimer));$('callout').addEventListener('pointerleave',delayClose);$('closeCard').onclick=()=>{closeCard();$('anchor').focus({preventScroll:true});closeCard()};document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeCard();stopAuto()}if(['ArrowDown','ArrowUp','PageDown','PageUp','Home','End',' '].includes(e.key)&&s.auto)stopAuto()});root.querySelectorAll('[data-p]').forEach(b=>b.onclick=()=>{stopAuto();go(Number(b.dataset.p))});$('reset').onclick=$('back').onclick=()=>{stopAuto();closeCard();go(0)};
$('auto').onclick=()=>{if(s.auto){stopAuto();return}if(rm.matches){$('load').hidden=false;$('load').textContent='减少动态效果已开启，请用章节入口查看关键帧。';return}go(0);s.auto=true;autoLast=0;$('auto').textContent='停止演示';$('auto').setAttribute('aria-pressed','true')};function tick(t){if(s.auto){if(!document.hidden){const dt=autoLast?Math.min((t-autoLast)/1000,.06):0;go(s.p+dt/s.duration);if(s.p>=.999)stopAuto()}autoLast=t}else autoLast=0;requestAnimationFrame(tick)}requestAnimationFrame(tick);
$('help').onclick=()=>{stopAuto();oldFocus=document.activeElement;closeCard();$('helpDialog').showModal()};$('closeHelp').onclick=()=>{$('helpDialog').close();oldFocus?.focus()};
addEventListener('scroll',()=>{if(s.open)closeCard();update()},{passive:true});addEventListener('wheel',()=>{if(s.auto)stopAuto()},{passive:true});addEventListener('touchstart',()=>{if(s.auto)stopAuto()},{passive:true});addEventListener('resize',layout);document.addEventListener('visibilitychange',()=>{autoLast=0});rm.addEventListener('change',()=>{stopAuto();closeCard();update()});
window.PalmXBanner={go,showCard,hideCard:closeCard,state:()=>({...s,reducedMotion:rm.matches,frameBox,point:s.key?projected():null}),setDemo:p=>{stopAuto();go(p)}};layout();
})();

})();</script>
<script>(()=>{'use strict';
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)], clamp=(n,a=0,b=1)=>Math.max(a,Math.min(b,n));
const reduced=matchMedia('(prefers-reduced-motion: reduce)');
let currentRoute='home',menu='',category='cnc',homeY=0,lastNav=null,dialogOpener=null,toastTimer,routeFilter='all';
window.__pxRouteOpen=false;
const cats=[
 {id:'cnc',name:'Desktop CNC',label:'桌面加工设备',items:['5-axis CNC Machine'],desc:'以主机为起点，了解产品的结构与使用体验。'},
 {id:'addons',name:'Add-ons',label:'功能扩展',items:['p1 add-ons'],desc:'配套扩展入口；具体名称、内容和适配关系待确认。'},
 {id:'bits',name:'CNC Bits',label:'刀具与套装',items:['Milling Bit Set','Engraving bits','3D carving bits','Drill bits'],desc:'将不同刀具类别清晰分组，而不是挤成一段链接。'},
 {id:'materials',name:'Materials',label:'材料目录',items:['wood'],desc:'这里是材料产品目录；首页 Materials 单独承担加工体验。'},
 {id:'tooling',name:'Tooling',label:'工装夹持',items:['Workholding Clamp Set / 工具夹件套装'],desc:'夹持配套单独展示，规格与适配机型待补充。'}
];
const scenarios=[
 {en:'Home use',zh:'让桌面，成为创作空间。',desc:'家庭创作场景的入口与内容布局。',img:'data:image/jpeg;base64,'},
 {en:'Education',zh:'让想法，有可触摸的答案。',desc:'教学与实践场景，具体方案待提供。',img:'data:image/jpeg;base64,'},
 {en:'Hobby & DIY',zh:'为每一个好奇，动手。',desc:'个人创作与兴趣项目的案例入口。',img:'data:image/jpeg;base64,'},
 {en:'Small Business',zh:'把创意，变成下一件作品。',desc:'小型工作室与业务场景的展示位置。',img:'data:image/jpeg;base64,'}
];
const policy={returns:['30 天退货','本条沿用原稿服务名称。退货地区、期限起算、商品状态、运费与例外条件尚未提供。'],warranty:['一年质保','本条沿用原稿服务名称。适用部件、耗材排除项、起算时间及办理方式待正式政策确认。'],delivery:['3 天发货','本条沿用原稿服务名称。库存条件、工作日口径、可配送地区及物流时效待正式说明。'],support:['24 × 7 服务','本条沿用原稿服务名称。支持渠道、在线范围、语言及时区待确认。']};
const references=[['Banner / Product Advantage','iyO：暗色展示、透视层次、靠近结构显示分析卡','https://www.awwwards.com/inspiration/interactive-webgl-exploded-view-iyo'],['Software','Shapr3D + Linear：操作与结果联系，稳定的界面窗口','https://www.shapr3d.com/product/visualization'],['Products','原 Products 五类结构：主机突出、配套分类可见',''],['Palmx Space','Snapmaker：自有社区入口与真实内容预览（地址待接入）','https://www.snapmaker.com/en/community'],['Proof','Linear Customers：横向封面、内容类型、播放入口','https://linear.app/customers'],['Discover','DJI：按使用场景组织图片入口','https://www.dji.com/handheld/activity'],['Materials','DJI Ronin 4D：从屏幕到现实的连续展示；按本项目脚本接入','https://www.dji.com/cn/ronin-4d'],['Why choose us','Autoplay Tabs：文字、图片与进度联动；自动方式未定','https://autoplay-tabs-cloneable.webflow.io/'],['Service','Apple：服务信息层级；这里保持平铺','https://www.apple.com/store'],['Explore','Teenage Engineering Now：编辑式图文排版','https://teenage.engineering/now'],['Footer','The Raum Objects：大字标与完整收尾画面','https://www.awwwards.com/inspiration/footer-the-raum-objects']];
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function notify(msg){clearTimeout(toastTimer);$('#toast').textContent=msg;$('#toast').hidden=false;toastTimer=setTimeout(()=>$('#toast').hidden=true,4200);}
function productArt(id){
 if(id==='cnc')return '<img src="data:image/jpeg;base64," alt="当前 v57 主机模型预览">';
 const head='<svg viewBox="0 0 360 210" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="'+esc(id)+' 分类图形占位" role="img"><defs><linearGradient id="g-'+id+'" x1="50" y1="20" x2="260" y2="180" gradientUnits="userSpaceOnUse"><stop stop-color="#cad0d6"/><stop offset=".45" stop-color="#6a737e"/><stop offset=".7" stop-color="#b3bcc5"/><stop offset="1" stop-color="#393f48"/></linearGradient></defs>';
 const f='url(#g-'+id+')';let s='';
 if(id==='bits'){for(let i=0;i<4;i++){let x=85+i*62;s+=`<rect x="${x}" y="23" width="19" height="78" rx="3" fill="${f}"/><path d="M${x} 101h19v62l-10 19-9-19Z" fill="${f}" stroke="#c6ccd3" stroke-width="1"/>`;for(let j=0;j<5;j++)s+=`<path d="m${x} ${105+j*11} 19 12" stroke="#30363f" stroke-width="4"/>`;}}
 if(id==='addons'){s=`<path d="m93 55 98-18 85 49-101 21Z" fill="${f}" stroke="#929aa5"/><path d="m93 55 82 52v68l-82-54Z" fill="#3d454e"/><path d="m175 107 101-21v68l-101 21Z" fill="#717b85"/>`;for(let i=0;i<5;i++)s+=`<path d="m${188+i*16} ${115-i*3}v36" stroke="#3e4751" stroke-width="4"/>`;}
 if(id==='materials'){s='<path d="m62 80 149-34 97 53-152 39Z" fill="#aa845f" stroke="#ceb091"/><path d="m62 80 94 58v34l-94-56Z" fill="#725035"/><path d="m156 138 152-39v33l-152 40Z" fill="#8e6948"/>';for(let i=0;i<7;i++)s+=`<path d="m${75+i*17} ${80-i*3.7} 87 50" stroke="#886444" stroke-width="1.3"/>`;}
 if(id==='tooling'){s=`<path d="m70 117 136-28 92 48-137 30Z" fill="${f}"/><path d="m70 117 91 50v22l-91-51ZM161 167l137-30v22l-137 30Z" fill="#515b66"/><path d="m92 67 37-8 57 30v47l-39 9-55-31Z" fill="${f}" stroke="#9aa3ad"/><path d="m217 45 29-6 44 22v50l-33 9-40-24Z" fill="${f}" stroke="#9aa3ad"/><path d="m181 111 60-13" stroke="#b8c0c9" stroke-width="9"/><circle cx="240" cy="97" r="8" fill="#5f6976"/>`;}
 return head+s+'</svg>';
}
function scenarioCards(){return scenarios.map((s,i)=>`<button class="scenario" data-scenario="${i}"><div class="scenario-layout type-${i+1}"><img src="${s.img}" alt="${s.en} 场景图占位，非实际使用照片" loading="lazy"></div><div class="scenario-shade"></div><span class="asset-tag">场景素材占位</span><div class="scenario-copy"><span class="number">0${i+1} / APPLICATION</span><h3 lang="en">${s.en}</h3><p>${s.zh}</p><span class="arrow">↗</span></div></button>`).join('');}
$('#scenarioGrid').innerHTML=scenarioCards();
function closeMenu(restore=false){$('#mega').hidden=true;$('#navScrim').hidden=true;$('#mobileNav').hidden=true;$('#menuToggle').setAttribute('aria-expanded','false');$$('[data-menu]').forEach(x=>x.setAttribute('aria-expanded','false'));menu='';if(restore)lastNav?.focus();}
function productMenu(){const c=cats.find(x=>x.id===category);return `<div class="mega-head"><strong>Products</strong><button class="ghost" data-close-menu aria-label="关闭产品菜单">关闭 ×</button></div><div class="mega-main"><div class="cat-list" role="tablist" aria-orientation="vertical" aria-label="产品类别">${cats.map(x=>`<button role="tab" aria-controls="megaProductDetails" tabindex="${x.id===category?0:-1}" aria-selected="${x.id===category}" class="cat-btn" data-menucat="${x.id}">${x.name}</button>`).join('')}</div><div class="mega-content" id="megaProductDetails" role="tabpanel" aria-label="${c.name}"><div class="mega-product-image">${productArt(c.id)}<span class="asset-tag">${c.id==='cnc'?'现有主机模型':'分类图形占位'}</span></div><div class="mega-product-copy"><span class="eyebrow">${c.label}</span><h3>${c.name}</h3><p>${c.desc}</p>${c.items.map((t,i)=>`<button class="menu-item" style="min-height:45px;padding:10px 0;width:100%" data-product="${c.id}:${i}"><b>${t}</b><span>↗</span></button>`).join('')}</div></div></div><div class="mega-bottom"><button class="text-link" data-route="products"><span>查看所有产品</span><span>↗</span></button><span class="fine">主机、扩展、刀具、材料与工装；不增加购物车、价格或虚构产品。</span></div>`;}
const menuInfo={software:{title:'Software',eyebrow:'SOFTWARE / DIGITAL TO PHYSICAL',head:'让每一步，都更清晰。',desc:'Pamlx Studio 与配套软件入口。先预览操作、过程与结果的展示关系。',button:'探索软件',image:'data:image/jpeg;base64,'},space:{title:'Palmx Space',eyebrow:'OUR OWN COMMUNITY',head:'创造，不必独自进行。',desc:'这里通向 Palm X 的自有社区。内容预览与社区地址待接入，不再作为视频链接。',button:'探索 Palmx Space',image:'data:image/jpeg;base64,'}};
function menuBody(k){if(k==='products')return productMenu();if(menuInfo[k]){const m=menuInfo[k];return `<div class="mega-head"><strong>${m.title}</strong><button class="ghost" data-close-menu>关闭 ×</button></div><div class="mega-simple"><div><div class="eyebrow">${m.eyebrow}</div><h3>${m.head}</h3><p>${m.desc}</p><button class="text-link" data-route="${k}" style="margin-top:22px"><span>${m.button}</span><span>↗</span></button>${k==='software'?'<button class="ghost" data-detail="other-software" style="display:block">other / 软件入口待定义</button>':''}</div><div class="menu-preview"><img src="${m.image}" alt="${m.title} 画面占位"><span class="menu-preview-label">${k==='space'?'自有社区入口 · 非真实帖子预览':'现有镜头 / 正式软件界面待接入'}</span></div></div>`;}
 const cfg=k==='community'?{title:'Community',h:'保持连接。',desc:'外部社交平台，与 Palmx Space 自有社区区分。',items:['Facebook Group','Reddit','LinkedIn','Discord'],type:'social'}:k==='explore'?{title:'Explore',h:'发现你的下一步。',desc:'Application 与 Wiki 按原导航组织，图文排版和轻量交互。',items:['Home use','Education','Hobby & DIY','Small Business','Wiki / Coming soon'],type:'explore'}:{title:'Support',h:'在需要时，找到答案。',desc:'品牌、联系、内容与合作信息，保持清楚的入口。',items:['About Us','Contact Us','News & Blog','Affiliate'],type:'support'};
 return `<div class="mega-head"><strong>${cfg.title}</strong><button class="ghost" data-close-menu>关闭 ×</button></div><div class="mega-simple"><div><div class="eyebrow">${cfg.title}</div><h3>${cfg.h}</h3><p>${cfg.desc}</p><button class="text-link" data-route="${k}" style="margin-top:25px"><span>打开 ${cfg.title}</span><span>↗</span></button></div><div class="mega-links">${cfg.items.map((t,i)=>{const attr=cfg.type==='social'?`data-social="${t}"`:cfg.type==='explore'?(i<4?`data-scenario="${i}"`:'data-detail="wiki"'):`data-detail="${['about','contact','news','affiliate'][i]}"`;return `<button class="menu-item" ${attr}><div><b>${t}</b><small>${cfg.type==='social'?'官方链接待接入':cfg.type==='explore'?'应用与内容入口':'查看说明与页面草稿'}</small></div><span>↗</span></button>`;}).join('')}</div></div>`;
}
function openMenu(k,trigger){lastNav=trigger||document.activeElement;if(menu===k&&!$('#mega').hidden){closeMenu();return;}$('#mobileNav').hidden=true;$('#menuToggle').setAttribute('aria-expanded','false');menu=k;$('#megaInner').innerHTML=menuBody(k);$('#mega').hidden=false;$('#navScrim').hidden=false;$$('[data-menu]').forEach(b=>b.setAttribute('aria-expanded',b.dataset.menu===k?'true':'false'));}
$('#mobileNav').innerHTML=['products','software','space','community','explore','support'].map((k,i)=>`<button data-menu="${k}" aria-expanded="false">${['Products','Software','Palmx Space','Community','Explore','Support'][i]}<span>+</span></button>`).join('')+'<button data-detail="reseller">Become to reseller <span>↗</span></button>';
$('#menuToggle').onclick=()=>{const open=$('#mobileNav').hidden;closeMenu();$('#mobileNav').hidden=!open;$('#menuToggle').setAttribute('aria-expanded',String(open));};$('#navScrim').onclick=()=>closeMenu(true);
function routeHeader(name,desc){return `<section class="route-hero"><div class="container"><div class="breadcrumb"><button data-route="home">首页</button><span>/</span><span>${name}</span></div><div class="eyebrow">PALM X / ${name.toUpperCase()}</div><h1 class="route-title" tabindex="-1">${name}</h1><p class="route-description">${desc}</p></div></section>`;}
function catalog(){const items=cats.flatMap(c=>c.items.map((name,i)=>({c,name,i}))).filter(x=>routeFilter==='all'||x.c.id===routeFilter);return items.map(({c,name,i})=>`<button class="catalog-card" data-product="${c.id}:${i}"><div class="small-index">${c.name.toUpperCase()}</div><div class="illustration">${productArt(c.id)}</div><h3>${name}</h3><p>${c.id==='cnc'?'主机模型预览':'分类素材占位 / 规格待补'}</p><span class="arr">↗</span></button>`).join('');}
function productsPage(){return routeHeader('Products','一台机器，以及围绕创造所需的配套。五类产品保持独立、清楚的浏览入口。')+`<section class="route-body"><div class="container"><div class="product-feature"><div class="image"><img src="data:image/jpeg;base64,