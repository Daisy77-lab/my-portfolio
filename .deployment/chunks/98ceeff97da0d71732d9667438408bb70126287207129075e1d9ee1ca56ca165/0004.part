<script>(()=>{const host=document.getElementById("banner-root");const root=host.attachShadow({mode:"open"});root.innerHTML="<style>\n[hidden]{display:none!important}:root{--bg:#0d0f12;--surface:#23262b;--ink:#f5f5f7;--muted:#b7bbc4;--dim:#969ba6;--line:#ffffff1f;--brand:#6c3baa;--focus:#b99ae4}*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:auto}body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.65 Manrope,\"Noto Sans SC\",\"PingFang SC\",\"Microsoft YaHei\",Arial,sans-serif}button,a{font:inherit;color:inherit;touch-action:manipulation}button{cursor:pointer}button:focus-visible,a:focus-visible{outline:2px solid var(--focus);outline-offset:4px}a{text-underline-offset:4px}.top{position:fixed;inset:0 0 auto;z-index:20;height:58px;padding:0 32px;display:flex;align-items:center;justify-content:space-between;background:linear-gradient(#0d0f12ee,#0d0f1200);gap:16px}.brand{font-size:19px;font-weight:600;letter-spacing:-.03em}.brand small{margin-left:16px;font-size:10px;font-weight:400;letter-spacing:.12em;color:var(--dim)}.tools{display:flex;gap:18px;align-items:center}.tools button{background:none;border:0;color:var(--muted);font-size:12px;padding:10px 4px;min-height:44px}.tools button:hover{color:white}.tools button[aria-pressed=true]{color:var(--focus)}.track{height:650vh;position:relative}.stage{position:sticky;top:0;height:100svh;overflow:hidden;background:var(--bg);isolation:isolate}.scene-frame{position:absolute;overflow:hidden;z-index:0}.scene-frame video,.scene-frame img{position:absolute;width:100%;height:100%;object-fit:fill}.scene-frame img{display:none}.stage.static .scene-frame img{display:block}.stage.static video{visibility:hidden}.veil{position:absolute;inset:0;z-index:1;pointer-events:none;background:linear-gradient(180deg,#0d0f1270,transparent 24%,transparent 78%,#0d0f12c7)}.hero-title{position:absolute;z-index:2;top:62px;left:20px;right:20px;text-align:center;pointer-events:none}.hero-title .kicker{font-size:10px;letter-spacing:.23em;color:var(--muted)}.hero-title h1{font-size:52px;line-height:1.1;letter-spacing:-.035em;font-weight:500;margin:9px 0 0}.inside-title{position:absolute;top:75px;left:36px;z-index:2;opacity:0;pointer-events:none}.inside-title .serial{font-size:10px;letter-spacing:.15em;color:var(--muted)}.inside-title h2{font-size:23px;font-weight:500;line-height:1.3;letter-spacing:-.02em;margin:10px 0 6px}.inside-title p{font-size:12px;color:var(--muted);margin:0;max-width:360px}.quality{position:absolute;right:36px;top:82px;max-width:230px;text-align:right;font-size:11px;color:var(--dim);z-index:2;line-height:1.7}.anchor{position:absolute;width:138px;height:116px;z-index:4;transform:translate(-50%,-50%);border:0;background:none;display:grid;place-items:center;padding:0}.anchor[hidden]{display:none}.anchor:focus-visible{border-radius:50%}.anchor:before{content:'';width:10px;height:10px;border:1px solid #e5e7ec;border-radius:50%;background:#0d0f1266;box-shadow:0 0 0 5px #ffffff06;transition:background .18s,box-shadow .18s}.anchor:hover:before,.anchor.active:before,.anchor:focus-visible:before{background:var(--focus);box-shadow:0 0 0 6px #b99ae414}.anchor-label{position:absolute;top:76px;left:50%;transform:translateX(-50%);white-space:nowrap;color:#e5e5e9;font-size:10px;letter-spacing:.02em;opacity:.82;text-shadow:0 1px 5px #000}.callout{position:absolute;z-index:6;width:410px;max-width:calc(100vw - 40px);padding:21px;display:grid;grid-template-columns:86px 1fr;gap:18px;background:linear-gradient(140deg,#30343be6,#22262ce8);backdrop-filter:blur(16px);border:1px solid #ffffff17;border-radius:14px;box-shadow:0 18px 70px #0003;opacity:0;visibility:hidden;transform:translateY(5px);transition:opacity .18s,transform .18s,visibility .18s}.callout.visible{opacity:1;visibility:visible;transform:none}.callout .thumb{width:86px;height:94px;object-fit:cover;border-radius:3px;align-self:center}.callout .placeholder-thumb{height:94px;display:grid;place-items:center;align-self:center;background:#ffffff05;border:1px solid #ffffff18;border-radius:3px;font-size:11px;color:var(--muted);text-align:center;line-height:1.6}.callout h3{font-size:20px;line-height:1.3;font-weight:500;margin:0 25px 9px 0}.callout p{font-size:14px;line-height:1.65;color:#c7cbd3;margin:0}.callout .tag{font-size:10px;color:var(--muted);display:block;margin-top:11px;letter-spacing:.02em}.callout .close{position:absolute;top:8px;right:8px;font-size:18px;width:32px;height:32px;background:none;border:0;color:var(--muted)}.connector{position:absolute;inset:0;width:100%;height:100%;z-index:5;pointer-events:none;opacity:0;transition:opacity .18s}.connector.visible{opacity:1}.connector path{stroke:#b9bdc6;stroke-width:1;fill:none;opacity:.6}.connector circle{fill:#ddd}.chapterbar{position:absolute;z-index:8;left:36px;right:36px;bottom:43px;border-top:1px solid var(--line);display:flex;justify-content:space-between;gap:22px;padding-top:10px;align-items:center}.chapters{display:flex;gap:25px}.chapters button{border:0;background:none;font-size:11px;color:var(--dim);padding:9px 0;min-height:38px;white-space:nowrap}.chapters button small{font-size:9px;letter-spacing:.04em;margin-right:7px;color:#7c828d}.chapters button[aria-current=step]{color:var(--ink)}.chapters button[aria-current=step] small{color:var(--focus)}.hint{font-size:11px;color:var(--muted);white-space:nowrap}.overall{position:absolute;left:0;top:-1px;height:1px;background:var(--focus);width:0}.disclaimer{position:absolute;bottom:15px;left:36px;right:36px;display:flex;justify-content:space-between;gap:18px;font-size:9px;color:var(--dim);z-index:8}.after{max-width:1100px;margin:auto;min-height:70svh;padding:96px 36px 120px}.after .label{font-size:11px;color:var(--dim);letter-spacing:.15em}.after h2{font-size:36px;font-weight:500;line-height:1.4;margin:17px 0 24px}.after p{font-size:15px;max-width:780px;line-height:1.8;color:var(--muted)}.after .notes{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin-top:38px}.after .notes div{border-top:1px solid var(--line);padding-top:18px}.after h3{font-weight:500;font-size:16px}.after button{margin-top:25px;min-height:44px;padding:10px 20px;background:transparent;border:1px solid #737985;border-radius:8px}.load{position:absolute;bottom:115px;left:50%;transform:translateX(-50%);font-size:12px;color:var(--muted);z-index:10;max-width:80%;text-align:center}.load[hidden]{display:none}dialog{width:min(640px,calc(100vw - 32px));max-height:90svh;overflow:auto;background:#191b20;color:var(--ink);border:1px solid #565c67;border-radius:12px;padding:28px}dialog::backdrop{background:#000a}dialog h2{font-size:24px;font-weight:500;margin:0 0 16px}dialog p{font-size:14px;color:var(--muted);line-height:1.8}dialog button{min-height:44px;border:0;background:var(--brand);border-radius:8px;padding:10px 24px} .sr-only{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}\n@media(max-width:760px){.top{padding:0 20px;height:56px}.brand small{display:none}.tools{gap:9px}.tools button{font-size:11px}.hero-title{top:94px}.hero-title h1{font-size:42px}.hero-title .kicker{font-size:9px;letter-spacing:.17em}.inside-title{left:22px;top:88px;right:22px}.inside-title h2{font-size:24px}.inside-title p{font-size:12px}.quality{top:auto;bottom:136px;right:22px;left:22px;max-width:none;text-align:center;font-size:10px}.anchor{width:100px;height:100px}.anchor-label{top:65px;font-size:10px}.callout{grid-template-columns:66px 1fr;width:calc(100vw - 40px);padding:18px;gap:14px;border-radius:12px}.callout .thumb{width:66px;height:80px}.callout .placeholder-thumb{height:80px;font-size:10px}.callout h3{font-size:17px}.callout p{font-size:12px}.chapterbar{left:20px;right:20px;bottom:48px;display:block;padding-top:8px}.chapters{justify-content:space-between;gap:8px}.chapters button{font-size:10px;min-height:38px}.chapters button small{display:none}.hint{font-size:10px;text-align:center;margin-top:3px}.disclaimer{left:20px;right:20px;bottom:13px;font-size:8px}.disclaimer span:last-child{display:none}.after{padding:64px 22px}.after h2{font-size:28px}.after .notes{grid-template-columns:1fr}.load{bottom:175px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important}.track{height:420vh}}\n\n:host{display:block;color:#f5f5f7;font-family:Manrope,\"Noto Sans SC\",\"Noto Sans CJK SC\",\"Microsoft YaHei\",sans-serif;line-height:1.65;--bg:#0d0f12;--surface:#23262b;--ink:#f5f5f7;--muted:#b7bbc4;--dim:#969ba6;--line:#ffffff1f;--brand:#6c3baa;--focus:#b99ae4}.top,.after{display:none!important}.hero-title{top:100px}.inside-title{top:104px}.quality{top:110px}.hero-title h1{font-weight:500}.disclaimer{font-size:10px}.stage{font-family:inherit} @media(max-width:760px){.hero-title{top:100px}.inside-title{top:92px}.quality{top:auto;bottom:136px}}</style>\n<header class=\"top\"><div class=\"brand\">Palm X <small>BANNER STUDY / V0.3</small></div><div class=\"tools\"><button id=\"help\">查看说明</button><button aria-pressed=\"false\" id=\"auto\">自动演示</button><button id=\"reset\">回到整机</button></div></header>\n<main><section aria-label=\"从整机正面进入内部的连续产品导览\" class=\"track\" id=\"track\"><div class=\"stage\" id=\"stage\">\n<div class=\"scene-frame\" id=\"sceneFrame\"><video aria-label=\"v57 原网格结构展示预览\" id=\"film\" muted=\"\" playsinline=\"\" poster=\"data:image/jpeg;base64,\" preload=\"auto\" src=\"data:video/mp4;base64,