',note:'v57 实际网格的外部渲染预览；刀库与激光对象尚待核对。'};openDialog(f.title,`<video controls muted playsinline autoplay src="${f.src}" aria-label="${f.title}"></video><div class="warning">${f.note}</div>`);$('#dialogContent video').play().catch(()=>{});}
function productDetail(key){const [cid,ix]=key.split(':'),c=cats.find(x=>x.id===cid);if(!c)return;const title=c.items[Number(ix)]||c.name;openDialog(title,`<div class="mega-content"><div class="mega-product-image">${productArt(cid)}</div><div><div class="eyebrow">${c.name}</div><h3 style="font-size:28px;line-height:1.3;margin:12px 0">${title}</h3><p class="muted" style="font-size:14px">${c.desc}</p></div></div><div style="margin-top:25px;display:grid;gap:12px;font-size:14px"><p>产品名称：${title}</p><p>适配关系：<span class="muted">待正式资料确认</span></p><p>规格与素材：<span class="muted">待接入</span></p></div><div class="warning">产品详情结构草稿，不新增价格、库存、性能参数或支付流程。</div><button class="primary" data-detail="contact" style="margin-top:24px">联系团队 ↗</button>`);}
function contactForm(type){return `<p>预览${type==='reseller'?'经销合作':type==='affiliate'?'联盟合作':'联系团队'}的表单结构。没有连接服务端，内容不会发送或保存。</p><form class="dialog-form" id="contactDraft" novalidate><div><label for="contactName">称呼</label><input class="input" id="contactName" name="name" autocomplete="name" required></div><div><label for="contactEmail">邮箱</label><input class="input" id="contactEmail" name="email" autocomplete="email" type="email" required></div>${type!=='contact'?'<div><label for="contactOrg">公司 / 组织</label><input class="input" id="contactOrg" name="organization" autocomplete="organization"></div>':''}<div><label for="contactText">${type==='contact'?'想了解什么？':'合作意向'}</label><textarea class="input" id="contactText" required></textarea></div><button class="primary" type="submit">检查表单 <span>↗</span></button><p class="form-message" id="contactStatus" role="status"></p></form>`;}
function detail(k){if(policy[k]){const [t,p]=policy[k];openDialog(t,`<p>${p}</p><div class="warning">原稿条目，政策待确认。本页不据此作出新的退货、质保、配送或支持承诺。</div><button class="text-link" data-detail="contact" style="margin-top:24px"><span>联系团队</span><span>↗</span></button>`);return;}
 if(['contact','reseller','affiliate'].includes(k)){openDialog({contact:'Contact Us',reseller:'Become to reseller',affiliate:'Affiliate'}[k],contactForm(k));return;}
 const info={about:['About Us','这里承接品牌初衷、设计原则与研发过程。正式品牌故事尚未提供；本稿不补写企业历史。'],news:['News & Blog','编辑式内容列表与详情入口已经预留。暂不编造发布日期、文章内容或作者。'],wiki:['Wiki / Coming soon','知识资源保持原稿的 Coming soon 状态。没有空白链接，也不假装教程已经上线。'],'other-software':['other / 软件入口','保留原稿的 other 子项。具体软件名称、功能和下载渠道尚未提供。'],privacy:['隐私说明','本草稿所有表单只在浏览器内验证格式，不发送、不存储个人信息。正式网站的数据处理与隐私政策需另行制定。'],terms:['使用条款','这是未部署的交互评审草稿，不是正式购买或使用协议。法律条款待业务确认。']};const a=info[k];if(a)openDialog(a[0],`<p>${a[1]}</p><div class="warning">内容位置已实现；正式资料待补。不会用虚构内容填满页面。</div>`);}
function scenarioDetail(i){const s=scenarios[i];openDialog(s.en,`<img src="${s.img}" alt="${s.en} 配图占位" style="width:100%;max-height:340px;object-fit:cover"><h3 style="font-size:26px;margin:25px 0 15px">${s.zh}</h3><p>${s.desc}</p><div class="warning">应用页面版式预览：真实用户场景、作品及验证条件待提供，当前画面不代表已完成的客户案例。</div><button class="text-link" data-jump-materials style="margin-top:22px"><span>探索从材料到作品</span><span>↗</span></button>`);}
// Event delegation keeps links live across destination pages and mega navigation.
document.addEventListener('click',e=>{
 const b=e.target.closest('button,a');if(!b)return;
 if(b.dataset.menu){openMenu(b.dataset.menu,b);return;}
 if(b.hasAttribute('data-close-menu')){closeMenu(true);return;}
 if(b.dataset.menucat){category=b.dataset.menucat;$('#megaInner').innerHTML=productMenu();$(`[data-menucat="${category}"]`)?.focus();return;}
 if(b.dataset.route){navigate(b.dataset.route);return;}
 if(b.dataset.categoryRoute){routeFilter=b.dataset.categoryRoute;navigate('products');return;}
 if(b.dataset.filter){routeFilter=b.dataset.filter;$$('[data-filter]').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.filter===routeFilter)));$('#catalogGrid').innerHTML=catalog();return;}
 if(b.dataset.product){productDetail(b.dataset.product);return;}
 if(b.dataset.detail){detail(b.dataset.detail);return;}
 if(b.dataset.social){notify(`${b.dataset.social} 官方地址尚未提供；本次仅演示入口，不跳转到无关页面。`);return;}
 if(b.hasAttribute('data-space-enter')){notify('Palmx Space 自有社区网址待接入；当前是官网入口草稿，尚未跳转。');return;}
 if(b.hasAttribute('data-scenario')){scenarioDetail(Number(b.dataset.scenario));return;}
 if(b.dataset.film){openFilm(b.dataset.film);return;}
 if(b.hasAttribute('data-jump-banner')){closeDialog();navigate('home');window.PalmXBanner?.go(0);return;}
 if(b.hasAttribute('data-jump-materials')){closeDialog();jump('#materialsTitle');return;}
 if(b.hasAttribute('data-software')){setSoftware(Number(b.dataset.software));return;}
 if(b.dataset.reviewJump){const d=b.dataset.reviewJump;d.startsWith('#')?jump(d):navigate(d);return;}
 if(b.tagName==='A'&&b.getAttribute('href')?.startsWith('#')&&$(b.getAttribute('href'))){e.preventDefault();jump(b.getAttribute('href'));}
});
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeMenu(true);stopWhy();}
 const cat=e.target.closest('[data-menucat]');if(cat&&['ArrowDown','ArrowUp','Home','End'].includes(e.key)){e.preventDefault();let i=cats.findIndex(c=>c.id===category);i=e.key==='Home'?0:e.key==='End'?4:(i+(e.key==='ArrowDown'?1:-1)+5)%5;category=cats[i].id;$('#megaInner').innerHTML=productMenu();$(`[data-menucat="${category}"]`).focus();}
});
function setSoftware(i){const src=['data:image/jpeg;base64,','data:image/jpeg;base64,','data:image/jpeg;base64,'][i],cap=['01 / 界面参考占位','02 / 操作区域与结构关联示意','03 / 结果画面占位'];$('#softwareImage').src=src;$('#softwareCaption').textContent=cap[i]+' · 非最终软件功能';$('#softwareResult').textContent=['任务与预览','过程与位置','结果与作品'][i];$$('.software-task').forEach(x=>x.classList.toggle('active',Number(x.dataset.software)===i));$$('.window-sidebar button').forEach(x=>x.classList.toggle('current',Number(x.dataset.software)===i));}
$('#proofPrev').onclick=()=>$('#proofTrack').scrollBy({left:-440,behavior:reduced.matches?'instant':'smooth'});$('#proofNext').onclick=()=>$('#proofTrack').scrollBy({left:440,behavior:reduced.matches?'instant':'smooth'});
// Materials: preserve the real uploaded shot. Missing recipes stay honestly empty.
const mats=[['metal','Metal','金属','#a4adb6'],['wood','Wood','木材','#947353'],['leather','Leather','皮革','#56453c'],['acrylic','Acrylic','亚克力','#8c9da4'],['other','Other','其他','#4b515a']];
const projects=[['sample','几何零件','当前镜头'],['qilin','麒麟立体模型','CNC 铣削 / 待素材'],['laser','激光作品','独立工艺 / 待素材']];
let ms={material:'metal',project:'sample',phase:0,p:0,processing:false,processStep:0,filmPaused:reduced.matches,filmReady:false,lastRecipe:'',processUploaded:false};
const mediaByRecipe=new Map();let materialRaf=0;let resultAttempt=false;
const currentRecipe=()=>ms.material+'_'+ms.project;
$('#materialOptions').innerHTML=mats.map(([id,en,zh,color])=>`<button class="material-option" data-mat="${id}" aria-pressed="${id==='metal'}"><span class="swatch" style="background:${color}"></span><span><b>${zh}</b><small>${en.toUpperCase()}</small></span><span class="check">✓</span></button>`).join('');
$('#materialProjects').innerHTML=projects.map(([id,name,tag],i)=>`<button class="material-option project-option" data-proj="${id}" aria-pressed="${id==='sample'}"><span class="p-no">0${i+1}</span><span><b>${name}</b><small>${tag}</small></span><span class="check">✓</span></button>`).join('');
function materialProgress(){const t=$('#materials');return clamp(-t.getBoundingClientRect().top/Math.max(1,t.offsetHeight-innerHeight));}
function seekVideo(v,t){if(v.readyState>=1&&Number.isFinite(v.duration)&&!v.seeking&&Math.abs(v.currentTime-t)>.04){try{v.currentTime=clamp(t,0,Math.max(0,v.duration-.04));}catch{}}}
function pauseMaterials(){$('#materialVideo').pause();$('#materialProcessVideo').pause();$('#materialResultVideo').pause();}
function matGo(p){if(currentRoute!=='home')navigate('home');const t=$('#materials');window.scrollTo({top:scrollY+t.getBoundingClientRect().top+clamp(p)*(t.offsetHeight-innerHeight),behavior:'instant'});updateMaterials();}
function missing(k,t,b){$('#materialMissing').hidden=false;$('#missingKicker').textContent=k;$('#missingTitle').textContent=t;$('#missingBody').textContent=b;}
function updateMaterials(){if(window.__pxRouteOpen)return;const rect=$('#materialStage').getBoundingClientRect(),visible=rect.bottom>85&&rect.top<innerHeight*.85;ms.p=materialProgress();const p=ms.p,v=$('#materialVideo'),hold=$('#materialHold'),proc=$('#materialProcessVideo'),result=$('#materialResultVideo'),inWork=p>=.35&&p<.78;
 $('#materialLeft').hidden=!inWork||ms.processing;$('#materialRight').hidden=!inWork||ms.processing;$('#materialAction').hidden=!inWork;$('#materialStart').hidden=ms.processing;$('#processUi').hidden=!ms.processing;$('#materialFilmControl').hidden=p<.9;$('#materialMissing').hidden=true;
 const ph=p<.35?0:p<.78?(ms.processing?2:1):3;ms.phase=ph;$$('[data-mat-p]').forEach((x,i)=>x.classList.toggle('active',i===ph));
 v.hidden=p>=.35;hold.hidden=p<.35;proc.hidden=true;result.hidden=true;
 const mat=mats.find(x=>x[0]===ms.material),pro=projects.find(x=>x[0]===ms.project),available=ms.material==='metal'&&ms.project==='sample';
 $('#materialJob').textContent=available?'现有开场尾帧 / 金属几何零件 / 非毛坯':`${mat[2]} / ${pro[1]} / 当前组合素材待补`;
 $$('[data-mat]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.mat===ms.material)));$$('[data-proj]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.proj===ms.project)));
 const captions=ph===0?['01 / SCREEN TO WORKSPACE','让想法，\n从屏幕走进现实。','当前采用你已提供的单镜头；滚动控制镜头进度。']:ph===1?['02 / CHOOSE YOUR OBJECT','一块材料。\n一种新的可能。','左侧选择材料，右侧选择作品。缺少对应素材的组合将明确显示占位。']:ph===2?['03 / CNC MILLING','从毛坯，\n到完整立体模型。','流程位置草稿，不用平板浮雕替代三维实体。']:['04 / OBJECT FILM','让作品，\n走进真实世界。','继续滚动直接进入影片区，不需要点击成品转场。'];
 $('#materialEyebrow').textContent=captions[0];$('#materialHeading').textContent=captions[1];$('#materialSubline').textContent=captions[2];$('#materialPhase').textContent=ph===0?'SCREEN → WORKSPACE':ph===1?'SELECT → MAKE':ph===2?'PROCESS / PREVIEW':'CONTINUE → FILM';$('#materialHint').textContent=ph===0?'↓ 向下滚动':ph===1?'选择后预览流程':ph===2?'↓ 无需等待，可继续':'影片区 / 下滚离开';
 if(p<.35){proc.pause();result.pause();v.pause();if(visible&&!reduced.matches)seekVideo(v,(p/.35)*Math.max(0,(v.duration||5)-.04));else if(reduced.matches)seekVideo(v,0);}
 else if(inWork){v.pause();result.pause();if(ms.processing){const a=mediaByRecipe.get(currentRecipe());if(a?.process){if(proc.src!==a.process)proc.src=a.process;proc.hidden=false;hold.hidden=true;if(visible&&!document.hidden&&!$('dialog[open]')&&!reduced.matches)proc.play().catch(()=>{});}else{proc.pause();missing('PROCESS PLACEHOLDER',ms.processStep===0?'毛坯镜头待补':ms.processStep===1?'CNC 粗加工镜头待补':'CNC 精加工镜头待补','这里只展示流程位置，不模拟虚假的加工进度。完整立体模型加工素材尚未接入。');}$('#processNote').textContent=a?.process?'当前播放本地导入的概念加工镜头':'评审占位 · 点选阶段切换说明 · 向下滚动继续';}
 else{proc.pause();$('#processNote').textContent='';if(!available)missing('MATERIAL / PROJECT',`${mat[2]} · ${pro[1]}`,'该组合尚无对应图片或影片，不用其他材料的镜头代替。');}}
 else{v.pause();proc.pause();const a=mediaByRecipe.get(currentRecipe());if(p>=.9&&a?.result){hold.hidden=true;result.hidden=false;if(result.src!==a.result){result.src=a.result;ms.filmPaused=reduced.matches;resultAttempt=false;}if(visible&&!ms.filmPaused&&!document.hidden&&!$('dialog[open]')&&!result.ended&&!resultAttempt){resultAttempt=true;result.play().then(()=>resultAttempt=false).catch(()=>{resultAttempt=false;ms.filmPaused=true;$('#resultPlay').textContent='点击播放影片';});}else if(!visible||ms.filmPaused||document.hidden||$('dialog[open]'))result.pause();$('#resultPlay').disabled=false;$('#resultPlay').textContent=result.ended?'重播影片':ms.filmPaused?'播放影片':'暂停影片';}
 else{result.pause();missing(p<.9?'MATCH TRANSITION':'RESULT FILM',p<.9?'成品对位推进 / 待补镜头':'同一件作品，在这里展开。',p<.9?'下滚触发转场。当前仅保持已有镜头末帧，不将它冒充加工完成画面。':'成品影片待接入。可从「目录与说明 → 本地素材接入」添加对应影片，进入区域后会静音播放。');$('#resultPlay').disabled=true;$('#resultPlay').textContent='作品影片待补';}}
 if(!visible||document.hidden||window.__pxRouteOpen)pauseMaterials();}
function scheduleMaterial(){if(!materialRaf)materialRaf=requestAnimationFrame(()=>{materialRaf=0;updateMaterials();});}
$$('[data-mat]').forEach(b=>b.onclick=()=>{ms.material=b.dataset.mat;ms.processing=false;pauseMaterials();updateMaterials();});$$('[data-proj]').forEach(b=>b.onclick=()=>{ms.project=b.dataset.proj;ms.processing=false;pauseMaterials();updateMaterials();});$$('[data-mat-p]').forEach(b=>b.onclick=()=>{if(Number(b.dataset.matP)===.61)ms.processing=true;matGo(Number(b.dataset.matP));});
$('#materialStart').onclick=()=>{ms.processing=true;ms.processStep=0;updateMaterials();};$('#materialAgain').onclick=()=>{ms.processing=false;pauseMaterials();updateMaterials();};$$('[data-process]').forEach(b=>b.onclick=()=>{ms.processStep=Number(b.dataset.process);$$('[data-process]').forEach(x=>x.classList.toggle('selected',x===b));updateMaterials();});
$('#resultPlay').onclick=()=>{const v=$('#materialResultVideo');if(v.ended){v.currentTime=0;ms.filmPaused=false;}else ms.filmPaused=!ms.filmPaused;updateMaterials();};
$('#materialVideo').addEventListener('loadeddata',scheduleMaterial);$('#materialVideo').addEventListener('seeked',scheduleMaterial);$('#materialResultVideo').addEventListener('ended',scheduleMaterial);$('#materialProcessVideo').addEventListener('ended',()=>{$('#processNote').textContent='片段结束。继续向下滚动进入作品影片。';});
// Why choose us — manual first; time-based mode is an explicit optional preview.
const whyData=[{title:'40 年 CNC 制造经验',desc:'经营年限与对应制造经验的证据待补。当前保留原稿信息层级。',number:'40',caption:'CNC 制造经验 · 实证配图待补',img:'data:image/jpeg;base64,