<!doctype html>
<html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><meta name="robots" content="noindex,nofollow"><title>Palm X · 官网整站交互草稿 v0.1</title><style>:root{color-scheme:dark;--bg:#101114;--deep:#0d0f12;--surface:#191b20;--raised:#23252b;--text:#f5f5f7;--sub:#b7bbc4;--muted:#969ba6;--line:#30343b;--control:#737985;--purple:#6c3baa;--hover:#7948b8;--focus:#b99ae4;--max:1280px;--gutter:48px;--ease:cubic-bezier(.22,1,.36,1)}
*{box-sizing:border-box}html{scroll-behavior:auto;background:var(--deep)}body{margin:0;background:var(--bg);color:var(--text);font:400 16px/1.65 Manrope,"Noto Sans SC","Noto Sans CJK SC","PingFang SC","Microsoft YaHei",Arial,sans-serif}h1,h2,h3,p{margin:0}h1,h2,h3{font-weight:500}button,input,textarea,select{font:inherit}button,a{color:inherit;touch-action:manipulation}button{cursor:pointer}a{text-decoration:none}img,video{display:block;max-width:100%}button{border:0}button:disabled{cursor:not-allowed;color:var(--muted)}:focus-visible{outline:2px solid var(--focus);outline-offset:4px}button[aria-disabled=true]{cursor:not-allowed}a.inline{text-decoration:underline;text-underline-offset:4px}[hidden]{display:none!important}.container{width:min(var(--max),calc(100% - 2*var(--gutter)));margin-inline:auto}.eyebrow{font-size:12px;letter-spacing:.14em;line-height:1.4;color:var(--sub);text-transform:uppercase}.muted{color:var(--muted)}.fine{font-size:12px;line-height:1.6;color:var(--muted)}.section{padding:120px 0;scroll-margin-top:80px}.section-title{font-size:48px;line-height:1.15;letter-spacing:-.025em;max-width:800px}.section-title:lang(zh){font-size:40px;letter-spacing:0;line-height:1.3}.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:40px;margin-bottom:44px}.section-head .eyebrow{margin-bottom:20px}.section-head p{color:var(--sub);font-size:15px;max-width:370px}.text-link{display:inline-flex;gap:18px;align-items:center;min-height:44px;background:none;padding:8px 0;border-bottom:1px solid #ffffff42;font-size:14px}.text-link span:last-child{transition:transform .18s}.text-link:hover span:last-child{transform:translate(3px,-3px)}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;gap:22px;min-height:48px;padding:12px 22px;border:1px solid transparent;border-radius:8px;font-size:14px;line-height:1.4;font-weight:600}.primary{background:var(--purple);color:white}.primary:hover{background:var(--hover)}.secondary{background:transparent;border-color:var(--control)}.secondary:hover{background:#ffffff08}.ghost{background:none;padding:8px 10px;min-height:44px;font-size:13px;color:var(--sub)}.tiny-tag{display:inline-flex;align-items:center;padding:5px 9px;border:1px solid #ffffff30;border-radius:4px;font-size:10px;line-height:1.3;color:var(--sub);letter-spacing:.03em}.asset-tag{position:absolute;left:16px;bottom:16px;font-size:10px;line-height:1.4;color:#e1e3e7;background:#101114b8;padding:5px 8px;border:1px solid #ffffff22;border-radius:3px;backdrop-filter:blur(8px)}.skip-link{position:fixed;z-index:300;left:20px;top:-70px;background:var(--purple);padding:12px 20px;border-radius:6px}.skip-link:focus{top:12px}.icon{width:24px;height:24px;display:block;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}
/* The only global navigation. */
.site-header{position:fixed;inset:0 0 auto;z-index:60;height:78px;background:#0d0f12ee;backdrop-filter:blur(18px);border-bottom:1px solid #ffffff14}.nav-shell{height:100%;display:flex;align-items:center;gap:32px}.wordmark{font-size:25px;font-weight:600;letter-spacing:-.05em;background:none;white-space:nowrap;line-height:1;padding:8px 0}.wordmark b{font-weight:500;margin-left:4px}.nav{display:flex;align-items:center;gap:4px;margin-left:auto}.nav-btn{position:relative;background:none;font-size:13px;color:#c5c8d0;min-height:48px;padding:12px 10px;white-space:nowrap}.nav-btn:hover,.nav-btn[aria-expanded=true]{color:#fff}.nav-btn[aria-expanded=true]:after{content:'';position:absolute;bottom:3px;left:10px;right:10px;height:2px;background:var(--focus)}.header-tail{display:flex;align-items:center;gap:12px}.header-cta{font-size:12px;min-height:40px;padding:10px 16px}.review-pill{font-size:9px;color:var(--sub);letter-spacing:.1em;border:1px solid #ffffff25;border-radius:3px;padding:4px 7px}.menu-toggle{display:none;background:none;padding:10px;min-width:44px;min-height:44px}.nav-scrim{position:fixed;z-index:48;inset:78px 0 0;background:#0009;backdrop-filter:blur(4px)}.mega{position:fixed;top:78px;inset-inline:0;z-index:55;background:#17191dfc;border-bottom:1px solid #ffffff28;box-shadow:0 25px 65px #0005;max-height:calc(100svh - 100px);overflow:auto}.mega-inner{padding:30px 0 35px}.mega-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:25px}.mega-head strong{font-size:20px;font-weight:500}.mega-main{display:grid;grid-template-columns:210px 1fr;gap:40px;min-height:290px}.cat-list{display:flex;flex-direction:column;border-right:1px solid var(--line);padding-right:24px}.cat-btn{background:none;color:var(--sub);display:flex;align-items:center;justify-content:space-between;text-align:left;min-height:50px;padding:10px 0;border-bottom:1px solid #ffffff09;font-size:14px}.cat-btn[aria-selected=true]{color:#fff}.cat-btn[aria-selected=true]:after{content:'→';color:var(--focus)}.mega-content{display:grid;grid-template-columns:minmax(200px,1fr) minmax(230px,1.08fr);gap:36px;align-items:center}.mega-product-image{height:245px;background:#0d0f12;display:grid;place-items:center;position:relative;overflow:hidden}.mega-product-image img{height:100%;width:100%;object-fit:cover}.mega-product-image svg{max-height:170px;width:70%;opacity:.8}.mega-product-copy h3{font-size:29px;letter-spacing:-.02em;margin:8px 0 10px}.mega-product-copy p{font-size:14px;color:var(--sub);margin-bottom:15px;max-width:420px}.mega-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:15px;margin-top:25px;gap:24px}.mega-simple{display:grid;grid-template-columns:1fr 1.4fr;gap:60px;align-items:center}.mega-simple h3{font-size:32px;margin:10px 0 16px}.mega-simple p{color:var(--sub);font-size:14px;max-width:400px}.mega-links{display:grid;grid-template-columns:1fr 1fr;gap:12px 30px}.menu-item{border-top:1px solid var(--line);padding:15px 0;background:none;text-align:left;display:flex;align-items:flex-start;justify-content:space-between;gap:20px;min-height:74px}.menu-item b{font-size:15px;font-weight:500;display:block}.menu-item small{display:block;font-size:11px;color:var(--muted);margin-top:5px}.menu-item>span{color:var(--sub)}.menu-item:hover b{color:var(--focus)}.menu-preview{position:relative;min-height:270px;overflow:hidden;background:#0e1013}.menu-preview img{width:100%;height:270px;object-fit:cover}.menu-preview-label{position:absolute;bottom:20px;left:22px;right:22px;font-size:15px}.menu-preview:after{content:'';position:absolute;inset:40% 0 0;background:linear-gradient(transparent,#0d0f12a0);pointer-events:none}.menu-preview-label{z-index:2}.mobile-drawer{position:fixed;inset:64px 0 0;z-index:56;background:#101114;padding:20px;overflow:auto}.mobile-drawer button{width:100%;display:flex;justify-content:space-between;background:none;border-bottom:1px solid var(--line);padding:18px 0;min-height:58px;font-size:20px;text-align:left}
/* Homepage. */
#banner-root{display:block;background:var(--deep)}.banner-skip{position:absolute;right:var(--gutter);top:calc(100svh - 144px);z-index:10;font-size:12px}.proof{background:#101114;border-top:1px solid var(--line)}.proof-track{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 48px)/3);gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}.proof-track::-webkit-scrollbar{display:none}.project-card{background:none;text-align:left;padding:0;scroll-snap-align:start;display:block}.project-media{position:relative;height:265px;overflow:hidden;background:#17191d}.project-media img{width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease)}.project-card:hover img{transform:scale(1.035)}.play-icon{position:absolute;right:18px;bottom:18px;width:42px;height:42px;border:1px solid #fff8;background:#10111480;border-radius:50%;display:grid;place-items:center;font-size:12px;backdrop-filter:blur(6px)}.project-body{padding:22px 0;border-bottom:1px solid var(--line)}.project-body .meta{display:flex;justify-content:space-between;gap:10px;font-size:10px;letter-spacing:.09em;color:var(--muted)}.project-body h3{font-size:22px;line-height:1.3;margin:10px 0 9px}.project-body p{color:var(--sub);font-size:13px}.section-controls{display:flex;gap:8px;flex-shrink:0}.arrow-btn{height:44px;width:44px;border:1px solid var(--control);border-radius:50%;background:transparent;display:grid;place-items:center}.arrow-btn:hover{background:#fff1}.section-note{display:flex;justify-content:space-between;gap:28px;margin-top:25px;align-items:center}.section-note p{font-size:12px;color:var(--muted);max-width:770px}
.discover{background:#14161a}.scenario-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.scenario{height:390px;position:relative;overflow:hidden;border:0;padding:0;background:#1c1f25;text-align:left}.scenario img,.scenario svg{width:100%;height:100%;object-fit:cover;transition:transform .65s var(--ease)}.scenario:hover img{transform:scale(1.035)}.scenario-shade{position:absolute;inset:0;background:linear-gradient(transparent 20%,#101114ee)}.scenario-copy{position:absolute;left:30px;right:30px;bottom:30px;z-index:2}.scenario-copy .number{font-size:11px;color:var(--sub)}.scenario-copy h3{font-size:30px;letter-spacing:-.02em;margin:5px 0}.scenario-copy p{font-size:13px;color:var(--sub);max-width:80%}.scenario-copy .arrow{position:absolute;right:0;bottom:0;font-size:25px}.scenario .asset-tag{top:17px;bottom:auto;left:auto;right:17px}.scenario-layout{position:absolute;inset:0;display:grid;align-items:center;justify-content:center;background:linear-gradient(155deg,#30343a,#101114)}.scenario-layout img{width:100%;height:100%;object-fit:contain}.scenario-layout.type-1 img{transform:scale(1.15) translateX(18%)}.scenario-layout.type-2 img{object-fit:cover;transform:scale(1.1)}.scenario-layout.type-3 img{transform:scale(1.12)}.scenario-layout.type-4 img{object-fit:cover;transform:scale(1.08)}
/* Material experience, one scene with optional footage slots. */
.material-intro{padding-bottom:48px}.material-track{position:relative;height:360vh;background:#0d0f12;scroll-margin-top:78px}.material-stage{position:sticky;top:0;height:100svh;min-height:720px;overflow:hidden;background:#0d0f12}.material-bg{position:absolute;inset:0}.material-bg video,.material-bg img{width:100%;height:100%;object-fit:cover}.material-vignette{position:absolute;inset:0;background:linear-gradient(180deg,#101114dc,transparent 37%,transparent 58%,#101114e8),linear-gradient(90deg,#101114dd,transparent 29%,transparent 70%,#101114dd);pointer-events:none}.material-heading{position:absolute;top:116px;left:var(--gutter);right:var(--gutter);pointer-events:none}.material-heading h2{font-size:38px;line-height:1.25;margin-top:14px;white-space:pre-line;letter-spacing:-.02em}.material-heading p{max-width:540px;color:var(--sub);font-size:13px;margin-top:15px}.material-phase{position:absolute;top:121px;right:var(--gutter);font-size:11px;color:var(--sub)}.material-rail{position:absolute;top:43%;width:200px;z-index:4}.material-rail.left{left:var(--gutter)}.material-rail.right{right:var(--gutter);width:250px}.rail-title{font-size:11px;color:var(--sub);letter-spacing:.12em;padding-bottom:12px;border-bottom:1px solid #ffffff38;margin-bottom:8px}.material-option{display:flex;align-items:center;gap:12px;width:100%;background:transparent;padding:10px 8px;min-height:48px;border-left:2px solid transparent;text-align:left;font-size:14px}.material-option[aria-pressed=true]{border-left-color:var(--focus);background:#101114c7}.material-option .swatch{height:26px;width:26px;border:1px solid #ffffff55;border-radius:50%;flex-shrink:0}.material-option b{font-weight:500;font-size:14px;display:block}.material-option small{display:block;font-size:10px;color:var(--sub)}.material-option .check{margin-left:auto;opacity:0;color:var(--focus)}.material-option[aria-pressed=true] .check{opacity:1}.mat-footnote{font-size:10px;color:var(--sub);margin-top:14px;line-height:1.6}.project-option{min-height:75px;border-bottom:1px solid #ffffff2c}.project-option .p-no{font-size:10px;color:var(--sub);width:17px}.material-action{position:absolute;left:28%;right:28%;bottom:124px;text-align:center;z-index:4}.material-action p{font-size:11px;margin-bottom:12px;color:var(--sub)}.material-placeholder{position:absolute;left:29%;right:29%;top:42%;bottom:29%;z-index:3;display:grid;place-content:center;text-align:center;background:#101114ed;border:1px solid #ffffff26;padding:24px;backdrop-filter:blur(16px)}.material-placeholder h3{font-size:22px;margin:12px 0}.material-placeholder p{font-size:12px;color:var(--sub);max-width:380px}.material-placeholder .icon{margin:0 auto;width:35px;height:35px;color:var(--muted)}.material-steps{position:absolute;bottom:48px;left:var(--gutter);right:var(--gutter);display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid #ffffff2c;padding-top:13px;z-index:5}.material-steps .step-items{display:flex;gap:20px}.material-steps button{background:none;color:var(--muted);font-size:11px;min-height:38px;padding:5px 0}.material-steps button.active{color:var(--text)}.material-steps button.active span{color:var(--focus)}.material-steps small{font-size:11px;color:var(--sub)}.material-disclaimer{position:absolute;bottom:14px;left:var(--gutter);right:var(--gutter);font-size:10px;color:var(--muted)}.process-steps{display:flex;justify-content:center;gap:12px}.process-steps button{min-height:42px;padding:8px 16px;background:#191b20;border:1px solid var(--control);font-size:12px;border-radius:6px}.process-steps button.selected{border-color:var(--focus)}.film-control{position:absolute;bottom:130px;right:var(--gutter);z-index:5}.film-control button{background:#1011149c}
.why{background:#14161a}.why-layout{display:grid;grid-template-columns:1fr 1.3fr;gap:70px;align-items:start}.why-options{margin-top:36px}.why-item{display:block;text-align:left;width:100%;background:none;border-top:1px solid var(--line);padding:22px 0;position:relative}.why-item h3{font-size:23px;line-height:1.35;color:var(--muted);transition:color .18s}.why-item[aria-selected=true] h3{color:var(--text)}.why-item .why-detail{display:none;color:var(--sub);font-size:13px;max-width:370px;margin-top:12px}.why-item[aria-selected=true] .why-detail{display:block}.why-item .index{display:inline-block;font-size:11px;vertical-align:middle;margin-right:15px;font-weight:400;color:var(--muted)}.why-item[aria-selected=true] .index{color:var(--focus)}.why-item .progress{position:absolute;top:-1px;height:1px;width:0;background:var(--focus)}.why-figure{position:relative;height:580px;background:#101114;overflow:hidden}.why-figure img{width:100%;height:100%;object-fit:cover;transition:opacity .32s}.why-figure:after{content:'';position:absolute;inset:0;background:linear-gradient(transparent 40%,#101114ee)}.why-figure .content{position:absolute;left:32px;right:32px;bottom:33px;z-index:2}.why-figure .content strong{font-size:72px;line-height:1;font-weight:500;letter-spacing:-.04em;display:block;margin-bottom:16px}.why-figure .content p{font-size:13px;color:var(--sub)}.why-footer{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:18px}.why-footer button{font-size:12px}
.services{padding:95px 0 110px;background:#101114;border-top:1px solid var(--line)}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:34px;margin-top:48px}.service{border-top:1px solid var(--line);padding:26px 0;text-align:left;background:none;position:relative}.service .icon{height:31px;width:31px;margin-bottom:28px;color:#d2d5dc}.service h3{font-size:24px;margin-bottom:10px}.service p{font-size:13px;color:var(--sub)}.service .arr{display:block;font-size:20px;margin-top:16px}.subscribe{padding:110px 0;background:#16181d}.subscribe-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:80px;align-items:end}.subscribe h2{font-size:55px;line-height:1.1;letter-spacing:-.025em;margin:18px 0}.subscribe p{font-size:14px;color:var(--sub)}.form-label{display:block;font-size:13px;margin-bottom:12px;color:var(--sub)}.email-row{display:flex;gap:12px}.input{display:block;width:100%;background:#101114;border:1px solid var(--control);border-radius:8px;padding:13px 15px;min-height:50px;color:var(--text);font-size:15px}.input::placeholder{color:var(--muted)}.email-row .primary{white-space:nowrap}.form-message{min-height:22px;margin-top:12px;font-size:12px;color:var(--sub)}.subscribe .fine{margin-top:12px;font-size:11px}.site-footer{background:#0b0d10;padding:70px 0 20px;overflow:hidden}.footer-top{display:grid;grid-template-columns:1.5fr repeat(4,1fr);gap:48px}.footer-title{font-size:26px;line-height:1.35;margin-bottom:16px;max-width:260px}.footer-col h3{font-size:12px;color:var(--muted);font-weight:400;letter-spacing:.06em;margin-bottom:17px}.footer-col button,.footer-col a{display:block;background:none;text-align:left;font-size:13px;line-height:1.5;margin:0 0 5px;padding:8px 0;min-height:36px;color:var(--sub)}.footer-col button:hover,.footer-col a:hover{color:#fff}.footer-mark{font-size:clamp(90px,21vw,310px);letter-spacing:-.07em;line-height:1.12;font-weight:500;text-align:center;margin:70px auto 20px;white-space:nowrap;color:#e2e4e9}.footer-bottom{display:flex;gap:24px;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:20px;font-size:10px;color:var(--muted)}.footer-bottom button{font-size:10px;background:none;color:var(--sub);padding:8px}.footer-notice{font-size:10px;color:#838b97;margin-top:18px}
/* Full navigation destination sketches. */
.route{min-height:100svh;padding-top:78px;background:#101114}.route-hero{padding:70px 0 62px;border-bottom:1px solid var(--line)}.breadcrumb{display:flex;gap:10px;align-items:center;font-size:12px;color:var(--muted);margin-bottom:36px}.breadcrumb button{background:none;color:var(--sub);padding:0;min-height:32px}.route-title{font-size:64px;line-height:1.1;letter-spacing:-.03em;font-weight:500;margin:15px 0 20px}.route-description{color:var(--sub);max-width:680px;font-size:16px}.route-body{padding:60px 0 110px}.product-feature{display:grid;grid-template-columns:1.4fr 1fr;gap:70px;align-items:center;margin-bottom:60px}.product-feature .image{position:relative;background:#0d0f12;min-height:360px;overflow:hidden}.product-feature .image img{width:100%;height:400px;object-fit:contain}.product-feature h2{font-size:42px;line-height:1.2;margin:12px 0 20px;letter-spacing:-.02em}.product-feature p{color:var(--sub);font-size:15px;margin-bottom:25px}.filter-row{display:flex;gap:12px;flex-wrap:wrap;border-bottom:1px solid var(--line);margin-bottom:36px}.filter{background:none;padding:12px 15px;font-size:14px;border-bottom:2px solid transparent;color:var(--muted);min-height:48px}.filter[aria-pressed=true]{color:var(--text);border-color:var(--focus)}.catalog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}.catalog-card{background:#17191d;min-height:340px;position:relative;display:flex;flex-direction:column;text-align:left;padding:24px}.catalog-card .illustration{height:180px;display:grid;place-items:center;margin-bottom:20px;position:relative}.catalog-card .illustration svg{height:150px;width:100%;color:#a0a8b4}.catalog-card .illustration img{height:180px;width:100%;object-fit:contain}.catalog-card h3{font-size:22px;line-height:1.3;margin-bottom:8px}.catalog-card p{font-size:12px;color:var(--sub);margin-top:auto}.catalog-card .small-index{font-size:10px;letter-spacing:.07em;color:var(--muted);margin-bottom:13px}.catalog-card .arr{position:absolute;bottom:23px;right:24px;font-size:20px}.catalog-note{margin-top:30px;font-size:12px;color:var(--muted)}.software-window{border:1px solid #ffffff25;background:#0d0f12;min-height:520px;margin:0 0 26px;position:relative;overflow:hidden}.window-bar{height:44px;background:#202329;display:flex;align-items:center;justify-content:space-between;font-size:11px;color:var(--sub);padding:0 20px}.window-body{display:grid;grid-template-columns:170px 1fr 180px;min-height:450px}.window-sidebar{padding:24px 18px;border-right:1px solid var(--line)}.window-sidebar button{display:block;text-align:left;width:100%;padding:12px 8px;min-height:48px;background:none;color:var(--sub);font-size:12px}.window-sidebar button.current{background:#6c3baa30;border-left:2px solid var(--focus);color:white}.window-canvas{position:relative;display:grid;place-items:center;overflow:hidden;min-height:450px;background:#14171b}.window-canvas img{width:100%;height:100%;object-fit:cover}.window-result{padding:24px 15px;border-left:1px solid var(--line);font-size:12px}.window-result b{font-size:12px;font-weight:500;display:block}.window-result img{height:140px;object-fit:cover;margin-top:18px}.window-result p{font-size:11px;color:var(--muted);margin-top:15px}.software-actions{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.software-task{background:none;text-align:left;border-top:2px solid var(--line);padding:22px 0}.software-task.active{border-color:var(--focus)}.software-task h3{font-size:22px;margin:10px 0}.software-task p{font-size:14px;color:var(--sub)}.space-banner{height:470px;position:relative;overflow:hidden;margin-bottom:35px;background:#0d0f12}.space-banner img{height:100%;width:100%;object-fit:cover;opacity:.75}.space-banner .overlay{position:absolute;inset:0;padding:48px;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(90deg,#101114da,transparent 80%)}.space-banner h2{font-size:55px;line-height:1.15;margin:18px 0;max-width:700px}.space-banner p{max-width:540px;font-size:15px;color:var(--sub);margin-bottom:24px}.space-banner .primary{width:max-content}.community-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.community-card{display:block;text-align:left;background:#17191d;border:1px solid var(--line);padding:36px;min-height:230px}.community-card .abbr{font-size:30px;line-height:1;width:52px;height:52px;display:grid;place-items:center;margin-bottom:22px;border:1px solid #ffffff36;border-radius:10px}.community-card h3{font-size:24px;margin-bottom:9px}.community-card p{color:var(--sub);font-size:14px}.community-card .status{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-top:25px}.support-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:24px}.support-card{border:1px solid var(--line);background:#17191d;text-align:left;padding:30px;min-height:180px}.support-card h3{font-size:24px;margin-bottom:14px}.support-card p{font-size:14px;color:var(--sub)}.faq{margin-top:48px;max-width:850px}.faq details{border-top:1px solid var(--line);padding:20px 0}.faq summary{cursor:pointer;font-size:17px}.faq p{font-size:14px;color:var(--sub);margin-top:15px}
/* Dialogs and review tools. */
dialog{border:1px solid #59616d;border-radius:12px;background:#191b20;color:var(--text);max-height:90svh;width:min(900px,calc(100vw - 40px));padding:32px;overflow:auto}dialog::backdrop{background:#000b;backdrop-filter:blur(8px)}.dialog-top{display:flex;justify-content:space-between;gap:25px;align-items:center;margin-bottom:23px}.dialog-top h2{font-size:28px;line-height:1.3}.close{background:transparent;min-width:44px;min-height:44px;border:1px solid var(--control);border-radius:50%;font-size:23px;flex-shrink:0}.dialog-content>p{font-size:15px;line-height:1.8;color:var(--sub);margin-bottom:18px}.dialog-content .warning{padding:16px 20px;background:#0d0f12;border-left:2px solid var(--focus);font-size:13px;color:var(--sub);line-height:1.7;margin-top:20px}.dialog-content video{width:100%;max-height:60svh;background:black}.dialog-form{display:grid;gap:18px;margin-top:24px}.dialog-form label{font-size:13px;color:var(--sub);display:block;margin-bottom:8px}.dialog-form textarea{min-height:100px;resize:vertical}.dialog-form .primary{justify-self:start}.review-fab{position:fixed;bottom:20px;right:22px;z-index:42;display:flex;align-items:center;gap:8px;min-height:42px;padding:10px 14px;background:#191b20ee;border:1px solid #ffffff39;border-radius:8px;font-size:11px;box-shadow:0 4px 24px #0004}.review-fab i{display:block;width:5px;height:5px;border-radius:50%;background:var(--focus)}.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);max-width:min(600px,calc(100vw - 40px));z-index:120;background:#23252b;border:1px solid #737985;padding:14px 22px;border-radius:8px;font-size:13px;box-shadow:0 8px 35px #0008}.review-list{display:grid;grid-template-columns:1fr 1fr;gap:12px}.review-list button{display:flex;justify-content:space-between;gap:15px;background:#101114;text-align:left;border:1px solid var(--line);padding:14px 16px;min-height:48px;font-size:13px}.review-list button span{font-size:11px;color:var(--muted)}.review-status{margin-top:25px;border-top:1px solid var(--line);padding-top:20px;font-size:13px;color:var(--sub);line-height:1.9}.review-status a{text-decoration:underline}.media-imports{display:grid;grid-template-columns:1fr 1fr;gap:18px}.media-imports label{display:block;border:1px solid var(--control);padding:20px;font-size:14px;border-radius:8px}.media-imports input{max-width:100%;font-size:12px;display:block;margin-top:15px}.video-poster{position:relative}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
