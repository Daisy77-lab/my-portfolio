rial-heading p{font-size:11px;margin-top:12px}.material-rail.left{top:auto;bottom:256px;left:20px;right:20px;width:auto;display:flex;flex-wrap:wrap;gap:5px}.material-rail.left .rail-title{width:100%;border:0;margin-bottom:3px;padding:0;font-size:10px}.material-rail.left .material-option{flex:1;min-height:42px;padding:5px 4px;gap:4px;border:1px solid #ffffff29;border-radius:5px;font-size:10px;min-width:0;justify-content:center}.material-rail.left .material-option b{font-size:10px}.material-rail.left .material-option small,.material-rail.left .check{display:none}.material-option .swatch{width:12px;height:12px}.material-rail.left .material-option[aria-pressed=true]{border-color:var(--focus)}.mat-footnote{display:none}.material-rail.right{top:auto;bottom:183px;left:20px;right:20px;width:auto;display:flex;gap:6px}.material-rail.right .rail-title{display:none}.project-option{min-width:0;padding:6px;flex:1;border:1px solid #ffffff2c;border-radius:5px;min-height:59px;gap:4px}.project-option b{font-size:11px}.project-option small{font-size:8px}.project-option .p-no,.project-option .check{display:none}.project-option[aria-pressed=true]{border-color:var(--focus)}.material-action{left:22px;right:22px;bottom:104px}.material-action p{font-size:10px;margin-bottom:6px}.material-action .primary{min-height:44px;font-size:12px}.material-placeholder{left:22px;right:22px;top:257px;bottom:auto;min-height:150px;max-height:200px;padding:18px}.material-placeholder h3{font-size:17px;margin:7px 0}.material-placeholder p{font-size:11px}.material-placeholder .icon{height:24px}.material-steps{left:20px;right:20px;bottom:43px;gap:9px;padding-top:8px}.material-steps .step-items{gap:12px}.material-steps button,.material-steps small{font-size:9px}.material-steps small{max-width:94px;text-align:right}.material-disclaimer{left:20px;right:20px;bottom:12px;font-size:8px}.film-control{bottom:170px;left:20px;right:auto}.route-hero{padding:40px 0}.route-title{font-size:43px}.route-description{font-size:14px}.breadcrumb{margin-bottom:22px}.route-body{padding-top:36px;padding-bottom:70px}.product-feature{grid-template-columns:1fr;gap:25px}.product-feature .image{min-height:250px}.product-feature .image img{height:280px}.product-feature h2{font-size:32px}.catalog-grid{grid-template-columns:1fr 1fr;gap:14px}.catalog-card{padding:16px;min-height:280px}.catalog-card .illustration{height:130px}.catalog-card .illustration svg,.catalog-card .illustration img{height:120px}.catalog-card h3{font-size:17px}.catalog-card p{font-size:10px;padding-right:15px}.catalog-card .arr{right:15px;bottom:15px}.filter-row{gap:4px}.filter{font-size:12px;padding:10px 8px}.window-body{grid-template-columns:1fr;min-height:320px}.window-sidebar{display:none}.window-canvas{min-height:320px}.software-window{min-height:360px}.window-bar{font-size:10px;padding:0 12px}.software-actions{grid-template-columns:1fr;gap:0}.software-task{padding:18px 0}.software-task h3{font-size:21px}.space-banner{height:430px}.space-banner .overlay{padding:26px}.space-banner h2{font-size:36px}.space-banner p{font-size:13px}.community-grid,.support-grid{grid-template-columns:1fr}.community-card{padding:26px;min-height:210px}.mega-main{grid-template-columns:115px 1fr;gap:20px}.cat-list{padding-right:12px}.cat-btn{font-size:12px}.mega-product-copy h3{font-size:22px}.mega-product-copy p{font-size:12px}.mega-bottom{display:block}.mega-bottom .fine{margin-top:10px}.mega-simple h3{font-size:27px}.menu-item b{font-size:14px}.menu-item small{font-size:10px}.review-fab{bottom:12px;right:12px;padding:8px 11px;min-height:38px;font-size:10px}dialog{padding:23px;width:calc(100vw - 24px)}.dialog-top h2{font-size:24px}.dialog-content>p{font-size:14px}.review-list{grid-template-columns:1fr}.media-imports{grid-template-columns:1fr}.toast{font-size:12px;bottom:65px}.review-fab .desktop-label{display:none}}
