","first":"data:image/jpeg;base64,","last":"data:image/jpeg;base64,"}</script>
<script>
(()=>{'use strict';
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const names={1:'屏幕进入现实',2:'工作台等待画面',3:'CNC 粗加工',4:'CNC 精加工与完整模型',5:'成品对位推进',6:'作品影片'};
const files={1:'01_screen-entry.mp4',2:'02_blank-hold.mp4 / .jpg',3:'03_rough.mp4',4:'04_finish.mp4',5:'05_result-push.mp4',6:'06_result-film.mp4'};
const materials={wood:'木材视觉',metal:'金属视觉'},projects={sample:'几何零件',qilin:'麒麟立体模型',laser:'激光作品'};
const assets=new Map(), rm=matchMedia('(prefers-reduced-motion: reduce)');
const s={material:'metal',project:'sample',scroll:0,inView:true,status:'idle',part:3,manualPause:false,filmPaused:rm.matches,filmBlocked:false,processBlocked:false,skipped:false};
let active=null,mode='',shownSlot=0,playPending=false,toastTimer,beforeDialog=null,raf=0,queue=[],partIndex=0;
const clamp=(v,a=0,b=1)=>Math.min(b,Math.max(a,v));
const recipe=()=>s.material+'_'+s.project;
const bucket=()=>{const k=recipe();if(!assets.has(k))assets.set(k,{});return assets.get(k)};
const isVideo=e=>e?.tagName==='VIDEO';
const hasAsset=a=>a&&!a.error;
const isMovie=a=>hasAsset(a)&&isVideo(a.element);
const canSelect=(m,p)=>!!assets.get(m+'_'+p)&&Object.values(assets.get(m+'_'+p)).some(hasAsset);
const slotLabel=n=>s.project==='laser'&&n===3?'激光工艺镜头':names[n];
const timeText=t=>Number.isFinite(t)?Math.max(0,t).toFixed(2).padStart(5,'0'):'00.00';
function toast(t){$('#toast').textContent=t;$('#toast').hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('#toast').hidden=true,3600)}
function progress(){const top=$('#track').getBoundingClientRect().top+scrollY;return clamp((scrollY-top)/Math.max(1,$('#track').offsetHeight-innerHeight))}
function goto(v){const top=$('#track').getBoundingClientRect().top+scrollY;window.scrollTo({top:top+clamp(v)*Math.max(1,$('#track').offsetHeight-innerHeight),behavior:'instant'});update()}
function pauseActive(){if(isVideo(active))active.pause()}
function schedule(){if(!raf)raf=requestAnimationFrame(()=>{raf=0;update()})}
function seek(e,t){if(e.readyState<1||!Number.isFinite(e.duration))return;const next=clamp(t,0,Math.max(0,e.duration-.034));if(!e.seeking&&Math.abs(e.currentTime-next)>.025){try{e.currentTime=next}catch{}}}
function setAssetView(n,m,p=0){
 const a=bucket()[n], valid=hasAsset(a), fallback=assets.get('metal_sample')?.[2];
 const e=valid?a.element:fallback?.element;shownSlot=n;
 if(e!==active){pauseActive();$('#media').replaceChildren();active=e||null;playPending=false;mode='';if(e)$('#media').append(e)}
 mode=m;$('#stage').classList.toggle('media-mode',!!valid);
 if(!valid){
  $('#missingSlot').textContent=String(n).padStart(2,'0')+' / 待补镜头';
  $('#missingTitle').textContent=slotLabel(n);
  $('#missingText').textContent=a?.error?'素材读取失败，请重新导入。':n===5?'本段没有新视频。背景仅保留开场尾帧；不会用它冒充成品转场。':n===6?'继续下滚即可进入这个影片区域。对应作品影片待补，当前没有自动播放其他镜头。':'这次只接入屏幕到作业台的镜头；此处等待对应素材。';
  return;
 }
 if(!isVideo(e))return;
 if(m==='scrub'){e.pause();seek(e,clamp(p)*Math.max(0,e.duration-.034))}
 else if(m==='first'||m==='last'){e.pause();seek(e,m==='first'?0:Math.max(0,e.duration-.034))}
 else if(m==='play'){
  if(e.paused&&!e.ended&&!playPending&&!document.hidden&&!$('#imports').open){
   playPending=true;const attempt=e.play();
   if(attempt?.then)attempt.then(()=>{playPending=false;if(active!==e||mode!=='play'||document.hidden||$('#imports').open)e.pause()}).catch(()=>{playPending=false;if(active!==e)return;if(n===6){s.filmPaused=true;s.filmBlocked=true}else{s.manualPause=true;s.processBlocked=true}toast('当前浏览器需要手动播放，请使用播放控制。');schedule()});else playPending=false;
  }
 }else e.pause();
}
function resetJob(){pauseActive();playPending=false;s.status='idle';s.part=3;s.manualPause=false;s.processBlocked=false;s.skipped=false;queue=[];partIndex=0;Object.values(bucket()).forEach(a=>{if(isVideo(a.element)){a.element.pause();try{a.element.currentTime=0}catch{}}});schedule()}
function userChoice(type,value){if(s.status==='making')return;const m=type==='material'?value:s.material,p=type==='project'?value:s.project;if(!canSelect(m,p)){toast('这个组合尚无素材，先保留当前镜头。');return}resetJob();s[type]=value;s.filmPaused=rm.matches;s.filmBlocked=false;updateCounts();update()}
function processSlots(){return [3,4].filter(n=>isMovie(bucket()[n]))}
function start(){const available=processSlots();if(!available.length){toast('加工镜头尚未接入，不模拟加工进度。');return}resetJob();queue=available;partIndex=0;s.status='making';s.part=queue[0];update()}
function finish(){pauseActive();s.status='done';s.manualPause=false;update()}
function nextPart(){if(s.status!=='making')return;partIndex++;if(partIndex<queue.length){s.part=queue[partIndex];const e=bucket()[s.part].element;try{e.currentTime=0}catch{}update()}else finish()}
function updateCounts(){
 const b=bucket(),num=Object.values(b).filter(a=>isMovie(a)).length;
 $('#assetCount').textContent='已接入 '+num+' 个镜头';
 $('#recipeLabel').textContent='当前组合：'+materials[s.material]+' + '+projects[s.project]+'（只按素材展示，不代表设备能力验证）';
 $$('.slot-box').forEach(el=>{const n=Number(el.dataset.slot),a=b[n];el.querySelector('b').textContent=String(n).padStart(2,'0')+' / '+slotLabel(n);el.querySelector('small').textContent=a?a.name+(a.error?' · 读取失败':a.derived?' · 派生停帧，非独立视频':' · 已接入'):'尚未导入';});
}
function setCopy(ph,v){
 let t;
 if(ph===0)t=['01 / FROM SCREEN TO WORKSPACE','让想法，\n从屏幕走进现实。','向下滚动推进这一镜。镜头结束后，选材界面在同一画面上展开。'];
 else if(ph===1)t=['02 / MATERIAL & PROJECT','在同一工作台，\n继续探索。','本次先看上传镜头与界面叠加；材料和作品联动待对应素材补齐。'];
 else if(ph===2)t=['03 / PROCESS PREVIEW','让加工过程，\n发生在眼前。','播放导入的加工片段；这是网页演示，不控制机器。'];
 else if(v<.88)t=['04 / CONTINUE SCROLLING','继续下滚，\n自然衔接下一镜。','原有转场路径保留；成品推进镜头待补，不增加必点按钮。'];
 else t=['05 / RESULT FILM','作品影片，\n在这里直接展开。',hasAsset(bucket()[6])?'进入本区后按正常时间静音播放；不需要点击转场。':'对应作品影片尚未接入；这一段暂时保留素材位。'];
 $('#eyebrow').textContent=t[0];$('#headline').textContent=t[1];$('#subline').textContent=t[2];
}
function update(){
 s.scroll=progress();const r=$('#stage').getBoundingClientRect();s.inView=r.bottom>Math.max(80,innerHeight*.35)&&r.top<innerHeight*.75;
 const v=s.scroll,work=v>=.29&&v<.72,film=v>=.88, ph=v<.29?0:work?(s.status==='idle'?1:2):3;
 $('#stage').className='stage '+(ph===0?'phase-entry':ph===1?'phase-selection':ph===2?'phase-process':'phase-following');
 setCopy(ph,v);
 $('#materials').hidden=!work||s.status==='making';$('#projects').hidden=!work||s.status==='making';$('#actions').hidden=!work;
 $('#ready').hidden=s.status!=='idle';$('#processing').hidden=s.status!=='making';$('#finished').hidden=s.status!=='done';
 $$('[data-material]').forEach(b=>{b.setAttribute('aria-pressed',String(b.dataset.material===s.material));b.disabled=s.status==='making'||!canSelect(b.dataset.material,s.project);b.title=b.disabled?'待补对应素材':'';});
 $$('[data-project]').forEach(b=>{b.setAttribute('aria-pressed',String(b.dataset.project===s.project));b.disabled=s.status==='making'||!canSelect(s.material,b.dataset.project);b.title=b.disabled?'待补对应素材':'';});
 const processReady=processSlots().length>0;$('#start').disabled=!processReady;$('#start').textContent=processReady?'播放加工演示 ↗':'加工镜头待补';
 $('#jobLabel').textContent=recipe()==='metal_sample'?'当前背景为开场尾帧 · 金属几何零件 · 非毛坯':materials[s.material]+' / '+projects[s.project];
 $('#processPause').textContent=s.manualPause?(s.processBlocked?'点击继续播放':'继续演示'):'暂停演示';
 $$('.steps li').forEach((el,i)=>i===ph?el.setAttribute('aria-current','step'):el.removeAttribute('aria-current'));
 $('#hint').textContent=v<.29?'↓ 滚动推进 / 向上回看':work?(processReady?'选择后播放加工':'↓ 后续镜头待补'):v<.88?'↓ 继续滚动，无需点击':'影片区 / 下滚离开';
 if(v<.29)setAssetView(1,rm.matches?'first':'scrub',clamp(v/.29));
 else if(work){if(s.status==='making')setAssetView(s.part,s.manualPause||$('#imports').open||document.hidden||!s.inView?'pause':'play');else{const hold=s.status==='done'?(queue.at(-1)||4):2;setAssetView(hold,s.status==='done'?'last':'first')}}
 else if(v<.88)setAssetView(5,rm.matches?'first':'scrub',clamp((v-.72)/.16));
 else setAssetView(6,s.filmPaused||$('#imports').open||document.hidden||!s.inView?'pause':'play');
 $('#filmControls').hidden=!film;const f=bucket()[6]?.element;$('#filmToggle').disabled=!isVideo(f);$('#filmToggle').textContent=!f?'待补作品影片':s.filmPaused?'播放视频':f.ended?'重播视频':'暂停视频';$('#filmState').textContent=!f?'未用开场镜头冒充成品影片':s.filmBlocked?'浏览器阻止自动播放，可恢复':rm.matches?'减少动态效果模式：主动播放':'静音自动播放 · 离开暂停';
 $('#clipMeter').hidden=v>=.72;
 const clip=assets.get('metal_sample')[1].element, duration=Number.isFinite(clip.duration)?clip.duration:5;
 $('#clipFill').style.width=(v<.29?clamp(v/.29)*100:100)+'%';
 $('#clipClock').textContent=timeText(v<.29?clip.currentTime:duration)+' / '+timeText(duration);
 $('#clipLabel').textContent=v<.29?(rm.matches?'低动态 / 首帧':'SCROLL / 镜头 01'):'HOLD / 同一镜头尾帧';
 if(s.status==='making'&&work){const e=bucket()[s.part]?.element;const frac=isVideo(e)&&Number.isFinite(e.duration)?clamp(e.currentTime/e.duration):0;const pc=Math.round((partIndex+frac)/Math.max(1,queue.length)*100);$('#progressFill').style.width=pc+'%';$('#progressBar').setAttribute('aria-valuenow',pc);$('#processText').textContent=slotLabel(s.part)+' · 影片进度 '+pc+'%';}
}
function makeAsset(n,url,name,image=false,options={}){
 const e=document.createElement(image?'img':'video'),a={url,element:e,name,error:false,...options};
 if(image){e.alt=options.derived?'从用户视频提取的作业台末帧，非毛坯':'用户导入的 '+slotLabel(n);e.onload=()=>{updateCounts();schedule()}}
 else{e.muted=true;e.defaultMuted=true;e.playsInline=true;e.setAttribute('muted','');e.setAttribute('playsinline','');e.preload='auto';e.loop=false;if(options.poster)e.poster=options.poster;e.addEventListener('loadeddata',()=>{updateCounts();schedule()});e.addEventListener('seeked',schedule);e.addEventListener('timeupdate',schedule);e.addEventListener('ended',()=>{if(active===e&&s.status==='making'&&s.part===n)nextPart();else schedule()});}
 e.onerror=()=>{a.error=true;updateCounts();schedule()};e.src=url;if(!image)e.load();return a;
}
function loadFile(n,file){if(!file)return;const image=file.type.startsWith('image/')||/\.(png|jpe?g|webp)$/i.test(file.name), video=file.type.startsWith('video/')||/\.(mp4|webm|mov|m4v)$/i.test(file.name);if(!image&&!video){toast('请选择 MP4 / WebM 或图片。');return}const b=bucket();if(b[n]){b[n].element.pause?.();if(b[n].url.startsWith('blob:'))URL.revokeObjectURL(b[n].url)}b[n]=makeAsset(n,URL.createObjectURL(file),file.name,image);$('#loadStatus').textContent='已导入 '+file.name+'。新增素材仅保留在本次会话，内嵌开场无需再次导入。';updateCounts();update()}
// One uploaded shot only. Slot 02 is its extracted final frame, not another shot.
const embedded=JSON.parse($('#embeddedMedia').textContent);
assets.set('metal_sample',{
 1:makeAsset(1,embedded.video,'视频节点 4.mp4 · 按内容接入开场',false,{builtIn:true,poster:embedded.first}),
 2:makeAsset(2,embedded.last,'视频节点 4.mp4 的末帧（非毛坯）',true,{builtIn:true,derived:true})
});
for(let n=1;n<=6;n++){const box=document.createElement('div');box.className='slot-box';box.dataset.slot=n;const b=document.createElement('b'),c=document.createElement('code'),input=document.createElement('input'),small=document.createElement('small');c.textContent=files[n];input.type='file';input.accept='video/*,image/png,image/jpeg,image/webp';input.id='asset-'+n;input.setAttribute('aria-label','导入 '+names[n]);input.onchange=()=>loadFile(n,input.files[0]);box.append(b,c,input,small);$('#slots').append(box)}
$('#batchFiles').onchange=e=>{let count=0;for(const file of e.target.files){const m=file.name.match(/^0?([1-6])[_\-]/);if(m){loadFile(Number(m[1]),file);count++}}if(!count)$('#loadStatus').textContent='请以 01_ 到 06_ 开头命名，或在对应素材位单独导入。'};
$('#importOpen').onclick=()=>{beforeDialog=document.activeElement;pauseActive();updateCounts();$('#imports').showModal();$('#closeImports').focus()};$('#closeImports').onclick=()=>{$('#imports').close();beforeDialog?.focus();update()};$('#imports').addEventListener('close',update);
$('#reset').onclick=()=>{resetJob();s.filmPaused=rm.matches;goto(0)};
$$('[data-material]').forEach(b=>b.onclick=()=>userChoice('material',b.dataset.material));$$('[data-project]').forEach(b=>b.onclick=()=>userChoice('project',b.dataset.project));
$('#start').onclick=start;$('#again').onclick=resetJob;$('#skip').onclick=()=>{s.skipped=true;finish();toast('已略过片段，不代表实际完成加工。')};$('#processPause').onclick=()=>{s.manualPause=!s.manualPause;s.processBlocked=false;update()};
$('#filmToggle').onclick=()=>{const e=bucket()[6]?.element;if(!isVideo(e))return;if(e.ended){e.currentTime=0;s.filmPaused=false}else s.filmPaused=!s.filmPaused;s.filmBlocked=false;update()};
addEventListener('scroll',schedule,{passive:true});addEventListener('resize',schedule);document.addEventListener('visibilitychange',()=>{if(document.hidden)pauseActive();schedule()});rm.addEventListener('change',()=>{s.filmPaused=rm.matches;schedule()});
window.PalmXVideoDraft={state:()=>({...s,recipe:recipe(),slot:shownSlot,mode,loaded:Object.keys(bucket()),reducedMotion:rm.matches,videoTime:assets.get('metal_sample')[1].element.currentTime,videoDuration:assets.get('metal_sample')[1].element.duration}),go:goto,start,finish,reset:()=>{resetJob();goto(0)},choose:(m,p)=>{if(m)userChoice('material',m);if(p)userChoice('project',p)}};
updateCounts();update();
})();

</script></body></html>